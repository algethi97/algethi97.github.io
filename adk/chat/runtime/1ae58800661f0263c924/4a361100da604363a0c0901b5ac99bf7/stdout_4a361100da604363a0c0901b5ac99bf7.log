s = [\r\n    { name = \"Algethi\", email = \"algethi97@gmail.com\" }\r\n]\r\nrequires-python = \">=3.12\"\r\ndependencies = [\r\n    \"supabase>=2.31.0\",\r\n]\r\n\r\n[project.scripts]\r\nalgethi97-github-io = \"algethi97_github_io:main\"\r\n\r\n[build-system]\r\nrequires = [\"uv_build>=0.12.5,<0.13.0\"]\r\nbuild-backend = \"uv_build\"\r\n.git\r\n.venv\r\nadk\r\nimages\r\nsrc\r\n.env\r\n.gitignore\r\n.python-version\r\nabout.html\r\ngame.html\r\ngame.js\r\nguestbook.html\r\nguestbook.js\r\nindex.html\r\nMANDARIN_GAME_PLAN.md\r\nportfolio.html\r\npyproject.toml\r\nREADME.md\r\nscript.js\r\nstyle.css\r\nuv.lock\r\nuv.lock\nstyle.css\nsrc\\algethi97_github_io\\__init__.py\nscript.js\nREADME.md\npyproject.toml\nportfolio.html\nMANDARIN_GAME_PLAN.md\nindex.html\nguestbook.js\nguestbook.html\ngame.js\ngame.html\nadk\\plans\\refactor-static-site.md\nadk\\plans\\refactor-static-site.board.md\nadk\\mapping.adesk.md\nabout.html\n1: // ==========================================================================\r\n2: // 방명록 로직 모듈 (guestbook.js)\r\n3: // Supabase Cloud 연동, RLS 보안 방어, XSS 차단, 쿨다운(도배 방지), 페이징\r\n4: // ==========================================================================\r\n5: \r\n6: const SUPABASE_CONFIG = {\r\n9: };\r\n10: \r\n11: const COOLDOWN_SECONDS = 30;\r\n12: const PAGE_SIZE = 15;\r\n13: \r\n14: let supabaseClient = null;\r\n15: let currentOffset = 0;\r\n16: let totalMessagesCount = 0;\r\n17: let isFetching = false;\r\n18: let isSubmitting = false;\r\n19: let cooldownInterval = null;\r\n20: \r\n21: // ==========================================================================\r\n22: // 초기화\r\n23: // ==========================================================================\r\n24: document.addEventListener('DOMContentLoaded', () => {\r\n25:   // 1. Supabase 클라이언트 초기화\r\n26:   if (window.supabase && window.supabase.createClient) {\r\n28:   } else {\r\n29:     console.error('Supabase SDK 로드 실패');\r\n30:     showNotification('데이터베이스 모듈을 불러오지 못했습니다. 페이지를 새로고침 해주세요.', '❌');\r\n31:     return;\r\n32:   }\r\n33: \r\n34:   // 2. DOM 요소 바인딩 및 이벤트 리스너 등록\r\n35:   initGuestbookEvents();\r\n36: \r\n37:   // 3. 이전 쿨다운 상태 복원\r\n38:   restoreCooldownState();\r\n39: \r\n40:   // 4. 초기 방명록 데이터 불러오기\r\n41:   loadGuestbookMessages(true);\r\n42: });\r\n43: \r\n44: // ==========================================================================\r\n45: // 이벤트 핸들러 초기화\r\n46: // ==========================================================================\r\n47: function initGuestbookEvents() {\r\n48:   const form = document.getElementById('guestbook-form');\r\n49:   const messageInput = document.getElementById('message');\r\n50:   const charCounter = document.getElementById('char-count');\r\n51:   const loadMoreBtn = document.getElementById('load-more-btn');\r\n52: \r\n53:   // 실시간 글자수 카운팅\r\n54:   if (messageInput && charCounter) {\r\n55:     messageInput.addEventListener('input', () => {\r\n56:       charCounter.textContent = messageInput.value.length;\r\n57:     });\r\n58:   }\r\n59: \r\n60:   // 방명록 제출 핸들러\r\n61:   if (form) {\r\n62:     form.addEventListener('submit', handleFormSubmit);\r\n63:   }\r\n64: \r\n65:   // 이전 방명록 더보기 버튼\r\n66:   if (loadMoreBtn) {\r\n67:     loadMoreBtn.addEventListener('click', () => {\r\n68:       loadGuestbookMessages(false);\r\n69:     });\r\n70:   }\r\n71: }\r\n72: \r\n73: // ==========================================================================\r\n74: // 방명록 목록 불러오기 (페이징 & 캐싱 부하 최소화)\r\n75: // ==========================================================================\r\n76: async function loadGuestbookMessages(isInitial = false) {\r\n77:   if (isFetching) return;\r\n78:   isFetching = true;\r\n79: \r\n80:   const listContainer = document.getElementById('guestbook-list');\r\n81:   const skeleton = document.getElementById('guestbook-skeleton');\r\n82:   const emptyState = document.getElementById('guestbook-empty');\r\n83:   const loadMoreBtn = document.getElementById('load-more-btn');\r\n84:   const totalCountEl = document.getElementById('total-count');\r\n85: \r\n86:   if (isInitial) {\r\n87:     currentOffset = 0;\r\n88:     listContainer.innerHTML = '';\r\n89:     skeleton.style.display = 'grid';\r\n90:     emptyState.style.display = 'none';\r\n91:     loadMoreBtn.style.display = 'none';\r\n92:   } else {\r\n93:     setButtonLoading(loadMoreBtn, true);\r\n94:   }\r\n95: \r\n96:   try {\r\n97:     const { data, error, count } = await supabaseClient\r\n98:       .from('guestbook')\r\n99:       .select('id, nickname, message, created_at', { count: 'exact' })\r\n100:       .order('created_at', { ascending: false })\r\n101:       .range(currentOffset, currentOffset + PAGE_SIZE - 1);\r\n102: \r\n103:     if (error) {\r\n104:       console.error('방명록 조회 오류:', error);\r\n105:       throw error;\r\n106:     }\r\n107: \r\n108:     if (count !== null && totalCountEl) {\r\n109:       totalMessagesCount = count;\r\n110:       totalCountEl.textContent = count;\r\n111:     }\r\n112: \r\n113:     if (isInitial && (!data || data.length === 0)) {\r\n114:       emptyState.style.display = 'block';\r\n115:       loadMoreBtn.style.display = 'none';\r\n116:     } else if (data && data.length > 0) {\r\n117:       data.forEach(item => {\r\n118:         const card = createMessageCardElement(item);\r\n119:         listContainer.appendChild(card);\r\n120:       });\r\n121: \r\n122:       currentOffset += data.length;\r\n123: \r\n124:       // 더 불러올 데이터가 남아있는지 판별\r\n125:       if (currentOffset < totalMessagesCount) {\r\n126:         loadMoreBtn.style.display = 'inline-flex';\r\n127:       } else {\r\n128:         loadMoreBtn.style.display = 'none';\r\n129:       }\r\n130:     }\r\n131:   } catch (err) {\r\n132:     console.error('방명록 로딩 중 실패:', err);\r\n133:     showNotification('방명록을 불러오는 중 문제가 발생했습니다.', '⚠️');\r\n134:   } finally {\r\n135:     isFetching = false;\r\n136:     skeleton.style.display = 'none';\r\n137:     if (!isInitial) {\r\n138:       setButtonLoading(loadMoreBtn, false);\r\n139:     }\r\n140:   }\r\n141: }\r\n142: \r\n143: // ==========================================================================\r\n144: // 방명록 등록 처리 (보안 검사, 쿨다운, 유효성 검증)\r\n145: // ==========================================================================\r\n146: async function handleFormSubmit(e) {\r\n147:   e.preventDefault();\r\n148: \r\n149:   if (isSubmitting) return;\r\n150: \r\n151:   // 1. 허니팟 필드(스팸 봇 감지) 검사\r\n152:   const honeypot = document.getElementById('honeypot-website');\r\n153:   if (honeypot && honeypot.value.trim() !== '') {\r\n154:     console.warn('봇 스팸 의심 요청 차단');\r\n155:     // 봇에게는 정상 등록된 것처럼 속이고 종료\r\n156:     document.getElementById('guestbook-form').reset();\r\n157:     showNotification('메시지가 등록되었습니다! ✨', '🎉');\r\n158:     return;\r\n159:   }\r\n160: \r\n161:   // 2. 쿨다운 검사\r\n162:   const remainingCooldown = getRemainingCooldown();\r\n163:   if (remainingCooldown > 0) {\r\n164:     showNotification(`도배 방지를 위해 ${remainingCooldown}초 후에 등록 가능합니다.`, '⏳');\r\n165:     return;\r\n166:   }\r\n167: \r\n168:   // 3. 입력값 추출 및 유효성 검사\r\n169:   const nicknameInput = document.getElementById('nickname');\r\n170:   const messageInput = document.getElementById('message');\r\n171:   const submitBtn = document.getElementById('submit-btn');\r\n172: \r\n173:   const nickname = nicknameInput.value.trim();\r\n174:   const message = messageInput.value.trim();\r\n175: \r\n176:   if (nickname.length < 1 || nickname.length > 20) {\r\n177:     showNotification('닉네임은 1자 이상 20자 이하로 입력해주세요.', '⚠️');\r\n178:     nicknameInput.focus();\r\n179:     return;\r\n180:   }\r\n181: \r\n182:   if (message.length < 1 || message.length > 500) {\r\n183:     showNotification('메시지 내용은 1자 이상 500자 이하로 입력해주세요.', '⚠️');\r\n184:     messageInput.focus();\r\n185:     return;\r\n186:   }\r\n187: \r\n188:   // 4. 전송 시작 (더블 서브밋 방지)\r\n189:   isSubmitting = true;\r\n190:   setButtonLoading(submitBtn, true);\r\n191: \r\n192:   try {\r\n193:     const { data, error } = await supabaseClient\r\n194:       .from('guestbook')\r\n195:       .insert([{ nickname, message }])\r\n196:       .select();\r\n197: \r\n198:     if (error) {\r\n199:       console.error('방명록 등록 오류:', error);\r\n200:       throw error;\r\n201:     }\r\n202: \r\n203:     // 5. 성공 처리\r\n204:     const newEntry = (data && data[0]) ? data[0] : {\r\n205:       id: Date.now(),\r\n206:       nickname,\r\n207:       message,\r\n208:       created_at: new Date().toISOString()\r\n209:     };\r\n210: \r\n211:     // 폼 초기화\r\n212:     document.getElementById('guestbook-form').reset();\r\n213:     document.getElementById('char-count').textContent = '0';\r\n214: \r\n215:     // 목록 상단에 새 메시지 카드 추가\r\n216:     const listContainer = document.getElementById('guestbook-list');\r\n217:     const emptyState = document.getElementById('guestbook-empty');\r\n218:     emptyState.style.display = 'none';\r\n219: \r\n220:     const card = createMessageCardElement(newEntry);\r\n221:     card.classList.add('just-added');\r\n222:     listContainer.prepend(card);\r\n223: \r\n224:     // 총 개수 갱신\r\n225:     totalMessagesCount += 1;\r\n226:     document.getElementById('total-count').textContent = totalMessagesCount;\r\n227: \r\n228:     // 쿨다운 시작 (30초)\r\n229:     startCooldown(COOLDOWN_SECONDS);\r\n230: \r\n231:     showNotification('방명록이 성공적으로 등록되었습니다! 🎉', '✨');\r\n232:   } catch (err) {\r\n233:     console.error('방명록 저장 실패:', err);\r\n234:     showNotification('방명록 저장에 실패했습니다. 잠시 후 다시 시도해주세요.', '⚠️');\r\n235:   } finally {\r\n236:     isSubmitting = false;\r\n237:     setButtonLoading(submitBtn, false);\r\n238:   }\r\n239: }\r\n240: \r\n241: // ==========================================================================\r\n242: // 메시지 카드 DOM 생성 (XSS 방어: escapeHtml 및 안전한 엘리먼트 빌드)\r\n243: // ==========================================================================\r\n244: function createMessageCardElement(entry) {\r\n245:   const card = document.createElement('article');\r\n246:   card.className = 'guestbook-card';\r\n247:   card.id = `guestbook-entry-${entry.id}`;\r\n248: \r\n249:   const safeNickname = escapeHtml(entry.nickname);\r\n250:   const safeMessage = escapeHtml(entry.message).replace(/\\n/g, '<br>');\r\n251:   const formattedTime = formatDateTime(entry.created_at);\r\n252:   const relativeTime = getRelativeTimeString(entry.created_at);\r\n253: \r\n254:   card.innerHTML = `\r\n255:     <div class=\"card-meta\">\r\n256:       <div class=\"meta-left\">\r\n257:         <span class=\"entry-badge\">#${entry.id}</span>\r\n258:         <strong class=\"entry-author\">${safeNickname}</strong>\r\n259:       </div>\r\n260:       <div class=\"meta-right\">\r\n261:         <span class=\"entry-time\" title=\"${formattedTime}\">${relativeTime}</span>\r\n262:       </div>\r\n263:     </div>\r\n264:     <div class=\"card-content\">\r\n265:       <p>${safeMessage}</p>\r\n266:     </div>\r\n267:   `;\r\n268: \r\n269:   return card;\r\n270: }\r\n271: \r\n272: // ==========================================================================\r\n273: // 쿨다운(도배 방지) 관리\r\n274: // ==========================================================================\r\n275: function startCooldown(seconds) {\r\n276:   const targetTime = Date.now() + (seconds * 1000);\r\n277:   localStorage.setItem('guestbook_cooldown_target', targetTime.toString());\r\n278:   updateCooldownUI(seconds);\r\n279: \r\n280:   if (cooldownInterval) clearInterval(cooldownInterval);\r\n281: \r\n282:   cooldownInterval = setInterval(() => {\r\n283:     const remaining = Math.ceil((targetTime - Date.now()) / 1000);\r\n284:     if (remaining <= 0) {\r\n285:       clearInterval(cooldownInterval);\r\n286:       cooldownInterval = null;\r\n287:       localStorage.removeItem('guestbook_cooldown_target');\r\n288:       endCooldownUI();\r\n289:     } else {\r\n290:       updateCooldownUI(remaining);\r\n291:     }\r\n292:   }, 1000);\r\n293: }\r\n294: \r\n295: function restoreCooldownState() {\r\n296:   const remaining = getRemainingCooldown();\r\n297:   if (remaining > 0) {\r\n298:     startCooldown(remaining);\r\n299:   }\r\n300: }\r\n301: \r\n302: function getRemainingCooldown() {\r\n303:   const target = localStorage.getItem('guestbook_cooldown_target');\r\n304:   if (!target) return 0;\r\n305:   const remaining = Math.ceil((parseInt(target, 10) - Date.now()) / 1000);\r\n306:   return remaining > 0 ? remaining : 0;\r\n307: }\r\n308: \r\n309: function updateCooldownUI(seconds) {\r\n310:   const submitBtn = document.getElementById('submit-btn');\r\n311:   const banner = document.getElementById('cooldown-banner');\r\n312:   const timerEl = document.getElementById('cooldown-timer');\r\n313: \r\n314:   if (submitBtn) {\r\n315:     submitBtn.disabled = true;\r\n316:     submitBtn.classList.add('is-cooling');\r\n317:   }\r\n318:   if (banner && timerEl) {\r\n319:     banner.style.display = 'flex';\r\n320:     timerEl.textContent = seconds;\r\n321:   }\r\n322: }\r\n323: \r\n324: function endCooldownUI() {\r\n325:   const submitBtn = document.getElementById('submit-btn');\r\n326:   const banner = document.getElementById('cooldown-banner');\r\n327: \r\n328:   if (submitBtn) {\r\n329:     submitBtn.disabled = false;\r\n330:     submitBtn.classList.remove('is-cooling');\r\n331:   }\r\n332:   if (banner) {\r\n333:     banner.style.display = 'none';\r\n334:   }\r\n335: }\r\n336: \r\n337: // ==========================================================================\r\n338: // 유틸리티 함수 (XSS 방어, 날짜 포맷, 버튼 로딩 상태)\r\n339: // ==========================================================================\r\n340: function escapeHtml(text) {\r\n341:   if (!text) return '';\r\n342:   return String(text)\r\n343:     .replace(/&/g, '&amp;')\r\n344:     .replace(/</g, '&lt;')\r\n345:     .replace(/>/g, '&gt;')\r\n346:     .replace(/\"/g, '&quot;')\r\n347:     .replace(/'/g, '&#039;');\r\n348: }\r\n349: \r\n350: function formatDateTime(isoString) {\r\n351:   if (!isoString) return '';\r\n352:   const date = new Date(isoString);\r\n353:   if (isNaN(date.getTime())) return '';\r\n354: \r\n355:   const pad = (n) => n.toString().padStart(2, '0');\r\n356:   const y = date.getFullYear();\r\n357:   const m = pad(date.getMonth() + 1);\r\n358:   const d = pad(date.getDate());\r\n359:   const hh = pad(date.getHours());\r\n360:   const mm = pad(date.getMinutes());\r\n361: \r\n362:   return `${y}.${m}.${d} ${hh}:${mm}`;\r\n363: }\r\n364: \r\n365: function getRelativeTimeString(isoString) {\r\n366:   if (!isoString) return '';\r\n367:   const date = new Date(isoString);\r\n368:   if (isNaN(date.getTime())) return '';\r\n369: \r\n370:   const diffMs = Date.now() - date.getTime();\r\n371:   const diffSec = Math.floor(diffMs / 1000);\r\n372:   const diffMin = Math.floor(diffSec / 60);\r\n373:   const diffHour = Math.floor(diffMin / 60);\r\n374:   const diffDay = Math.floor(diffHour / 24);\r\n375: \r\n376:   if (diffSec < 60) return '방금 전';\r\n377:   if (diffMin < 60) return `${diffMin}분 전`;\r\n378:   if (diffHour < 24) return `${diffHour}시간 전`;\r\n379:   if (diffDay < 7) return `${diffDay}일 전`;\r\n380: \r\n381:   return formatDateTime(isoString);\r\n382: }\r\n383: \r\n384: function setButtonLoading(button, isLoading) {\r\n385:   if (!button) return;\r\n386:   const textSpan = button.querySelector('.btn-text');\r\n387:   const loaderSpan = button.querySelector('.btn-loader');\r\n388: \r\n389:   if (isLoading) {\r\n390:     button.disabled = true;\r\n391:     if (textSpan) textSpan.style.opacity = '0.5';\r\n392:     if (loaderSpan) loaderSpan.style.display = 'inline-block';\r\n393:   } else {\r\n394:     button.disabled = false;\r\n395:     if (textSpan) textSpan.style.opacity = '1';\r\n396:     if (loaderSpan) loaderSpan.style.display = 'none';\r\n397:   }\r\n398: }\r\n399: \r\n400: function showNotification(message, icon = '💬') {\r\n401:   if (typeof window.showToast === 'function') {\r\n402:     window.showToast(message, icon);\r\n403:   } else {\r\n404:     alert(message);\r\n405:   }\r\n406: }\r\n407: \r\n<!DOCTYPE html>\r\n<html lang=\"ko\">\r\n<head>\r\n  <meta charset=\"UTF-8\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n  <title>방명록 | algethi97</title>\r\n  <link rel=\"stylesheet\" href=\"style.css\">\r\n</head>\r\n<body class=\"standalone-page\">\r\n\r\n  <!-- 상단 네비게이션 헤더 -->\r\n  <header class=\"nav-header\">\r\n    <div class=\"nav-inner\">\r\n      <!-- 좌측 상단: 홈페이지로 돌아오도록 하는 버튼 (픽토그램) -->\r\n      <a href=\"index.html\" class=\"home-button\" aria-label=\"홈페이지로 돌아가기\" title=\"홈페이지로 돌아가기\">\r\n        <svg class=\"home-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\r\n          <path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path>\r\n          <polyline points=\"9 22 9 12 15 12 15 22\"></polyline>\r\n        </svg>\r\n      </a>\r\n\r\n      <!-- 4칸짜리 탭 네비게이션 -->\r\n      <div class=\"tabs-container\">\r\n        <nav class=\"tabs-grid four-tabs\">\r\n          <!-- 왼쪽 칸: 자기소개 -->\r\n          <a href=\"about.html\" class=\"tab-item\" id=\"tab-about\">\r\n            👤 자기소개\r\n          </a>\r\n          <!-- 중앙 칸: 포트폴리오 -->\r\n          <a href=\"portfolio.html\" class=\"tab-item\" id=\"tab-portfolio\">\r\n            💼 포트폴리오\r\n          </a>\r\n          <!-- 방명록 (현재 활성화된 탭) -->\r\n          <a href=\"guestbook.html\" class=\"tab-item active\" id=\"tab-guestbook\">\r\n            📝 방명록\r\n          </a>\r\n          <!-- 우측 칸: 만다린 게임 -->\r\n          <a href=\"game.html\" class=\"tab-item\" id=\"tab-game\">\r\n            🍊 만다린 게임\r\n          </a>\r\n        </nav>\r\n      </div>\r\n    </div>\r\n  </header>\r\n\r\n  <!-- 메인 콘텐츠 영역 -->\r\n  <main class=\"main-content\">\r\n    <div class=\"page-header\">\r\n      <h1 class=\"page-title\">Guestbook 📝</h1>\r\n      <p class=\"page-subtitle\">소중한 발자국을 남겨주세요. 남겨주신 메시지는 큰 힘이 됩니다!</p>\r\n    </div>\r\n\r\n    <!-- 방명록 작성 폼 카드 -->\r\n    <section class=\"card guestbook-form-card\">\r\n      <div class=\"card-header-row\">\r\n        <h2>✍️ 방명록 작성하기</h2>\r\n        <span class=\"safe-badge\" title=\"안전한 암호화 통신 및 스팸 방어 적용\">🔒 안심 방명록</span>\r\n      </div>\r\n      \r\n      <form id=\"guestbook-form\" class=\"guestbook-form\" autocomplete=\"off\">\r\n        <!-- 봇 차단용 허니팟 필드 (사람 눈에는 보이지 않음) -->\r\n        <div class=\"visually-hidden\" aria-hidden=\"true\">\r\n          <label for=\"honeypot-website\">Do not fill this</label>\r\n          <input type=\"text\" id=\"honeypot-website\" name=\"website\" tabindex=\"-1\" autocomplete=\"off\">\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <label for=\"nickname\" class=\"form-label\">\r\n            닉네임 <span class=\"required-star\">*</span>\r\n          </label>\r\n          <input \r\n            type=\"text\" \r\n            id=\"nickname\" \r\n            class=\"form-input\" \r\n            placeholder=\"닉네임을 입력하세요 (최대 20자)\" \r\n            maxlength=\"20\" \r\n            required\r\n          >\r\n        </div>\r\n\r\n        <div class=\"form-group\">\r\n          <div class=\"label-row\">\r\n            <label for=\"message\" class=\"form-label\">\r\n              메시지 내용 <span class=\"required-star\">*</span>\r\n            </label>\r\n            <span class=\"char-count\"><span id=\"char-count\">0</span> / 500자</span>\r\n          </div>\r\n          <textarea \r\n            id=\"message\" \r\n            class=\"form-textarea\" \r\n            rows=\"4\" \r\n            placeholder=\"따뜻한 인사말이나 피드백을 자유롭게 남겨주세요.\" \r\n            maxlength=\"500\" \r\n            required\r\n          ></textarea>\r\n        </div>\r\n\r\n        <div class=\"form-footer\">\r\n          <button type=\"submit\" id=\"submit-btn\" class=\"btn btn-primary guestbook-submit-btn\">\r\n            <span class=\"btn-text\">📝 메시지 등록하기</span>\r\n            <span class=\"btn-loader\" style=\"display: none;\"></span>\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 도배 방지 쿨다운 알림 바 -->\r\n        <div id=\"cooldown-banner\" class=\"cooldown-banner\" style=\"display: none;\">\r\n          <span class=\"cooldown-icon\">⏳</span>\r\n          <span class=\"cooldown-text\">도배 방지를 위해 <strong><span id=\"cooldown-timer\">30</span>초</strong> 후에 추가 작성이 가능합니다.</span>\r\n        </div>\r\n      </form>\r\n    </section>\r\n\r\n    <!-- 남겨진 방명록 목록 섹션 -->\r\n    <section class=\"card guestbook-list-section\">\r\n      <div class=\"card-header-row\">\r\n        <h2>💬 남겨진 이야기들</h2>\r\n        <span class=\"count-pill\">총 <strong id=\"total-count\">0</strong>개</span>\r\n      </div>\r\n\r\n      <!-- 로딩 스켈레톤 -->\r\n      <div id=\"guestbook-skeleton\" class=\"guestbook-skeleton-wrap\" style=\"display: none;\">\r\n        <div class=\"skeleton-card\"></div>\r\n        <div class=\"skeleton-card\"></div>\r\n        <div class=\"skeleton-card\"></div>\r\n      </div>\r\n\r\n      <!-- 방명록 리스트 -->\r\n      <div id=\"guestbook-list\" class=\"guestbook-list\"></div>\r\n\r\n      <!-- 방명록이 없을 때 Empty State -->\r\n      <div id=\"guestbook-empty\" class=\"guestbook-empty\" style=\"display: none;\">\r\n        <div class=\"empty-icon\">🍃</div>\r\n        <p class=\"empty-title\">아직 남겨진 방명록이 없습니다.</p>\r\n        <p class=\"empty-desc\">첫 번째 주인공이 되어 따뜻한 발자국을 남겨보세요!</p>\r\n      </div>\r\n\r\n      <!-- 이전 방명록 더보기 버튼 -->\r\n      <div class=\"load-more-wrap\">\r\n        <button type=\"button\" id=\"load-more-btn\" class=\"btn load-more-btn\" style=\"display: none;\">\r\n          <span class=\"btn-text\">이전 방명록 더보기 ⬇️</span>\r\n          <span class=\"btn-loader\" style=\"display: none;\"></span>\r\n        </button>\r\n      </div>\r\n    </section>\r\n\r\n    <!-- 홈으로 돌아가기 버튼 -->\r\n    <div style=\"text-align: center; margin-top: 2rem;\">\r\n      <a href=\"index.html\" style=\"color: var(--accent-orange); font-weight: 600;\">&larr; 홈으로 돌아가기</a>\r\n    </div>\r\n  </main>\r\n\r\n  <footer class=\"site-footer\">\r\n    <p>&copy; 2026 algethi97. All rights reserved.</p>\r\n  </footer>\r\n\r\n  <!-- Supabase JS Client CDN -->\r\n  <script src=\"https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2\"></script>\r\n  <!-- 공통 스크립트 -->\r\n  <script src=\"script.js\"></script>\r\n  <!-- 방명록 전용 스크립트 -->\r\n  <script src=\"guestbook.js\"></script>\r\n</body>\r\n</html>\r\n\r\nscript.js:20:      showToast('준비 중인 탭입니다. 곧 새로운 콘텐츠로 찾아올게요!', '⏳');\nscript.js:118:    showToast('모니터 화면에 진입했습니다. 탭을 눌러 이동해보세요!', '🖥️');\nscript.js:129:    showToast('데스크 전체 뷰로 전환되었습니다.', '🔍');\nscript.js:170:function showToast(message, icon = '📋') {\nscript.js:226:      showToast(customMessage, '✅');\nscript.js:229:      showToast('복사에 실패했습니다. 다시 시도해 주세요.', '⚠️');\ngame.js:170:    if (window.supabase && window.supabase.createClient) {\ngame.js:171:      supabaseClient = window.supabase.createClient(SUPABASE_CONFIG.url, SUPABASE_CONFIG.key);\ngame.js:247:        showToast(soundManager.isMuted ? '🔇 효과음이 꺼졌습니다.' : '🔊 효과음이 켜졌습니다.');\ngame.js:797:        showToast('명예의 전당(Top 5)이 갱신되었습니다. ✨');\ngame.js:802:        showToast('랭킹을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.');\ngame.js:866:        timeSpan.textContent = formatTimeAgo(item.created_at);\ngame.js:898:      showToast('데이터베이스에 연결할 수 없습니다.');\ngame.js:912:      showToast('이미 이번 게임의 점수가 등록되었습니다. 새 게임에 도전해 보세요!');\ngame.js:921:      showToast(`도배 방지를 위해 ${waitSec}초 후에 다시 시도해 주세요.`);\ngame.js:931:      showToast('닉네임을 1글자 이상 입력해 주세요.');\ngame.js:937:      showToast('닉네임은 최대 20자까지 가능합니다.');\ngame.js:943:      showToast('비정상적인 점수 데이터입니다.');\ngame.js:950:    setButtonLoading(submitBtn, true);\ngame.js:973:      showToast(`🎉 ${rawNickname}님의 점수(${score}점)가 명예의 전당에 등록되었습니다!`);\ngame.js:985:      showToast('점수 등록 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.');\ngame.js:987:      setButtonLoading(submitBtn, false);\ngame.js:1013:  function setButtonLoading(button, isLoading) {\ngame.js:1028:  function showToast(msg) {\ngame.js:1050:  function formatTimeAgo(isoString) {\n", "exitCode": 0, "durationMs": 100, "startedAtMs": 1793854601350, "compl