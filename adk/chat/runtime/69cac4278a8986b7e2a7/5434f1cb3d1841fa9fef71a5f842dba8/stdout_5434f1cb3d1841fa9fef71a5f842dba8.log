age.get(\"deleted_at\"):\n            candidate[\"messages\"].append(dict(id=uuid.uuid4().hex, room_id=room_id, sender=\"ADesk\",\n                request_id=None, status=\"completed\", created_at=_now(), text=\"작업 재개 보류: 유효한 재개 대기 기록이 없습니다.\"))\n            self._commit(candidate)\n            return None\n        self._commit(candidate)\n        request = dict(request, task_resume={key: deepcopy(pending[key])\n                       for key in (\"task_response\", \"run_id\", \"target_step\")})\n        return self._resume_task_from_chat(request, message, pending[\"body\"], confirmed=pending)\n\n    def _resume_task_from_chat(self, request, message, body, *, automatic=False, confirmed=None):\n        from .task_relay import can_resume_rejection, waiting_task_context\n        from ..conversation.delivery import deliveries\n        candidate = self._snapshot()\n        context = request.get(\"task_resume\") or {}\n        reference = context.get(\"task_response\") or {}\n        proposal = next((p for p in candidate[\"proposals\"] if p[\"id\"] == reference.get(\"proposal_id\")), None)\n        try:\n            if not proposal:\n                raise ValueError(\"재개할 대기 질문이 없습니다.\")\n            if any(proposal.get(key) != reference.get(key) for key in (\"approval_id\", \"execution_plan_hash\")):\n                raise ValueError(\"질문의 계획·승인 키가 바뀌었습니다. 최신 질문을 확인하세요.\")\n            plan_document.assert_unchanged(proposal)\n            if proposal.get(\"agent_id\") != request[\"agent_id\"] or proposal.get(\"room_id\") != request[\"room_id\"]:\n                raise ValueError(\"작업을 신청한 AI의 같은 방 대화에서만 재개할 수 있습니다.\")\n            question = proposal.get(\"task_question\") or {}\n            if (question.get(\"judgment_pending\") or any(r.get(\"kind\") == \"assertion_judge\"\n                    and r.get(\"status\") in (\"queued\", \"running\") and r.get(\"proposal_id\") == proposal[\"id\"]\n                    for r in candidate[\"requests\"])):\n                raise 