.className = 'mandarin-tile';\n   442\t      tileEl.dataset.index = idx;\n   443\t      tileEl.dataset.row = row;\n   444\t      tileEl.dataset.col = col;\n   445\t      tileEl.dataset.val = val;\n   446\t\n   447\t      tileEl.innerHTML = `\n   448\t        <img src=\"images/mandarin.png\" alt=\"귤\" class=\"tile-bg-mandarin\" draggable=\"false\">\n   449\t        <span class=\"tile-number\">${val}</span>\n   450\t      `;\n   451\t\n   452\t      fragment.appendChild(tileEl);\n   453\t\n   454\t      tilesData.push({\n   455\t        index: idx,\n   456\t        row,\n   457\t        col,\n   458\t        value: val,\n   459\t        isCleared: false,\n   460\t        el: tileEl\n   461\t      });\n   462\t    }\n   463\t\n   464\t    board.appendChild(fragment);\n   465\t  }\n   466\t\n   467\t  // 성능 최적화: boardContainer 기준으로 타일 BoundingBox 캐싱\n   468\t  function cacheTileBoundingBoxes() {\n   469\t    const container = document.getElementById('board-container');\n   470\t    if (!container) return;\n   471\t    const containerRect = container.getBoundingClientRect();\n   472\t\n   473\t    cachedTileRects = tilesData.map((tile) => {\n   474\t      if (tile.isCleared) return null;\n   475\t      const r = tile.el.getBoundingClientRect();\n   476\t      return {\n   477\t        left: r.left - containerRect.left,\n   478\t        top: r.top - containerRect.top,\n   479\t        right: r.right - containerRect.left,\n   480\t        bottom: r.bottom - containerRect.top,\n   481\t        width: r.width,\n   482\t        height: r.height\n   483\t      };\n   484\t    });\n   485\t  }\n   486\t\n   487\t  // ==========================================================================\n   488\t  // 드래그 인터랙션 & 합계 10 판정 (Desktop Mouse & Mobile Touch 지원)\n   489\t  // ==========================================================================\n   490\t  function initDragEvents(boardContainer) {\n   491\t    const selectionBox = document.getElementById('selection-box');\n   492\t    const sumBadge = document.getElementById('sum-badge');\n   493\t    const sumBadgeVal = document.getElementById('sum-badge-val');\n   494\t\n   495\t    function getPointerPos(e) {\n   496\t      const containerRect = boardContainer.getBoundingClientRect();\n   497\t      let clientX, clientY;\n   498\t\n   499\t      if (e.touches && e.touches.length > 0) {\n   500\t        clientX = e.touches[0].clientX;\n   501\t        clientY = e.touches[0].clientY;\n   502\t      } else if (e.changedTouches && e.changedTouches.length > 0) {\n   503\t        clientX = e.changedTouches[0].clientX;\n   504\t        clientY = e.changedTouches[0].clientY;\n   505\t      } else {\n   506\t        clientX = e.clientX;\n   507\t        clientY = e.clientY;\n   508\t      }\n   509\t\n   510\t      return {\n   511\t        x: clientX - containerRect.left,\n   512\t        y: clientY - containerRect.top,\n   513\t        rawClientX: clientX,\n   514\t        rawClientY: clientY\n   515\t      };\n   516\t    }\n   517\t\n   518\t    // 드래그 시작 핸들러\n   519\t    function onDragStart(e) {\n   520\t      if (!isGameRunning) return;\n   521\t      // 터치 시 스크롤 방지\n   522\t      if (e.type === 'touchstart') {\n   523\t        e.preventDefault();\n   524\t      }\n   525\t\n   526\t      isDragging = true;\n   527\t      const pos = getPointerPos(e);\n   528\t      dragStartX = pos.x;\n   529\t      dragStartY = pos.y;\n   530\t\n   531\t      selectionBox.style.display = 'block';\n   532\t      selectionBox.style.left = `${dragStartX}px`;\n   533\t      selectionBox.style.top = `${dragStartY}px`;\n   534\t      selectionBox.style.width = '0px';\n   535\t      selectionBox.style.height = '0px';\n   536\t      selectionBox.classList.remove('is-ten');\n   537\t\n   538\t      sumBadge.style.display = 'block';\n   539\t      sumBadge.classList.remove('is-ten');\n   540\t      sumBadgeVal.textContent = '0';\n   541\t\n   542\t      selectedTileIndexes.clear();\n   543\t      updateTileSelection(dragStartX, dragStartY, dragStartX, dragStartY);\n   544\t    }\n   545\t\n   546\t    // 드래그 이동 핸들러\n   547\t    function onDragMove(e) {\n   548\t      if (!isDragging || !isGameRunning) return;\n   549\t      if (e.type === 'touchmove') {\n   550\t        e.preventDefault();\n   551\t      }\n   552\t\n   553\t      const pos = getPointerPos(e);\n   554\t      const curX = pos.x;\n   555\t      const curY = pos.y;\n   556\t\n   557\t      const left = Math.min(dragStartX, curX);\n   558\t      const top = Math.min(dragStartY, curY);\n   559\t      const width = Math.abs(curX - dragStartX);\n   560\t      const height = Math.abs(curY - dragStartY);\n   561\t\n   562\t      selectionBox.style.left = `${left}px`;\n   563\t      selectionBox.style.top = `${top}px`;\n   564\t      selectionBox.style.width = `${width}px`;\n   565\t      selectionBox.style.height = `${height}px`;\n   566\t\n   567\t      // 합계 배지 위치\n   568\t      sumBadge.style.left = `${curX + 15}px`;\n   569\t      sumBadge.style.top = `${curY - 30}px`;\n   570\t\n   571\t      // 타일 충돌 검사 및 합계 산출\n   572\t      updateTileSelection(left, top, left + width, top + height);\n   573\t    }\n   574\t\n   575\t    // 드래그 종료 핸들러\n   576\t    function onDragEnd(e) {\n   577\t      if (!isDragging) return;\n   578\t      isDragging = false;\n   579\t\n   580\t      selectionBox.style.display = 'none';\n   581\t      selectionBox.classList.remove('is-ten');\n   582\t      sumBadge.style.display = 'none';\n   583\t      sumBadge.classList.remove('is-ten');\n   584\t\n   585\t      if (!isGameRunning) {\n   586\t        clearSelectionVisuals();\n   587\t        return;\n   588\t      }\n   589\t\n   590\t      // 합계 검사\n   591\t      let sum = 0;\n   592\t      const targets = [];\n   593\t      selectedTileIndexes.forEach((idx) => {\n   594\t        const tile = tilesData[idx];\n   595\t        if (tile && !tile.isCleared) {\n   596\t          sum += tile.value;\n   597\t          targets.push(tile);\n   598\t        }\n   599\t      });\n   600\t\n   601\t      if (sum === 10 && targets.length > 0) {\n   602\t        // 🍊 성공: 합계가 10!\n   603\t        handleSuccessClear(targets);\n   604\t      } else {\n   605\t        // 실패: 합이 10이 아님 -> Shake 연출 후 선택 해제\n   606\t        if (targets.length > 0) {\n   607\t          targets.forEach((t) => {\n   608\t            t.el.classList.add('shake-fail');\n   609\t            setTimeout(() => {\n   610\t              t.el.classList.remove('shake-fail');\n   611\t              t.el.classList.remove('selected');\n   612\t              t.el.classList.remove('is-ten');\n   613\t            }, 300);\n   614\t          });\n   615\t        }\n   616\t      }\n   617\t\n   618\t      selectedTileIndexes.clear();\n   619\t    }\n   620\t\n   621\t    // 타일 충돌 검사 함수 (AABB 박스 충돌)\n   622\t    function updateTileSelection(boxLeft, boxTop, boxRight, boxBottom) {\n   623\t      let currentSum = 0;\n   624\t      const newlySelected = new Set();\n   625\t\n   626\t      for (let i = 0; i < TOTAL_TILES; i++) {\n   627\t        const tile = tilesData[i];\n   628\t        if (!tile || tile.isCleared) continue;\n   629\t\n   630\t        const rect = cachedTileRects[i];\n   631\t        if (!rect) continue;\n   632\t\n   633\t        const isOverlap =\n   634\t          rect.right > boxLeft &&\n   635\t          rect.left < boxRight &&\n   636\t          rect.bottom > boxTop &&\n   637\t          rect.top < boxBottom;\n   638\t\n   639\t        if (isOverlap) {\n   640\t          newlySelected.add(i);\n   641\t          currentSum += tile.value;\n   642\t        }\n   643\t      }\n   644\t\n   645\t      // 클래스 토글\n   646\t      for (let i = 0; i < TOTAL_TILES; i++) {\n   647\t        const tile = tilesData[i];\n   648\t        if (!tile || tile.isCleared) continue;\n   649\t\n   650\t        const isNowSelected = newlySelected.has(i);\n   651\t        if (isNowSelected) {\n   652\t          tile.el.classList.add('selected');\n   653\t        } else {\n   654\t          tile.el.classList.remove('selected');\n   655\t          tile.el.classList.remove('is-ten');\n   656\t        }\n   657\t      }\n   658\t\n   659\t      selectedTileIndexes = newlySelected;\n   660\t\n   661\t      // 합계 10 도달 여부 시각화\n   662\t      if (currentSum === 10) {\n   663\t        selectionBox.classList.add('is-ten');\n   664\t        sumBadge.classList.add('is-ten');\n   665\t        sumBadgeVal.textContent = '10 ✨';\n   666\t        selectedTileIndexes.forEach((idx) => {\n   667\t          tilesData[idx].el.classList.add('is-ten');\n   668\t        });\n   669\t      } else {\n   670\t        selectionBox.classList.remove('is-ten');\n   671\t        sumBadge.classList.remove('is-ten');\n   672\t        sumBadgeVal.textContent = currentSum;\n   673\t        selectedTileIndexes.forEach((idx) => {\n   674\t          tilesData[idx].el.classList.remove('is-ten');\n   675\t        });\n   676\t      }\n   677\t    }\n   678\t\n   679\t    function clearSelectionVisuals() {\n   680\t      tilesData.forEach((t) => {\n   681\t        if (t && t.el) {\n   682\t          t.el.classList.remove('selected', 'is-ten', 'shake-fail');\n   683\t        }\n   684\t      });\n   685\t      selectedTileIndexes.clear();\n   686\t    }\n   687\t\n   688\t    // 마우스 이벤트 등록\n   689\t    boardContainer.addEventListener('mousedown', onDragStart);\n   690\t    window.addEventListener('mousemove', onDragMove);\n   691\t    window.addEventListener('mouseup', onDragEnd);\n   692\t\n   693\t    // 터치 이벤트 등록 (모바일)\n   694\t    boardContainer.addEventListener('touchstart', onDragStart, { passive: false });\n   695\t    window.addEventListener('touchmove', onDragMove, { passive: false });\n   696\t    window.addEventListener('touchend', onDragEnd);\n   697\t    window.addEventListener('touchcancel', onDragEnd);\n   698\t  }\n   699\t\n   700\t  // ==========================================================================\n   701\t  // 합계 10 완성 시 타일 제거 & Pop 애니메이션 & 스코어링\n   702\t  // ==========================================================================\n   703\t  function handleSuccessClear(targetTiles) {\n   704\t    const count = targetTiles.length;\n   705\t    score += count;\n   706\t    remainingCount -= count;\n   707\t\n   708\t    // 1. Pop 사운드 효과음 재생\n   709\t    soundManager.playPop(1.0 + (count * 0.05));\n   710\t    soundManager.playSuccessChime();\n   711\t\n   712\t    // 2. 중심 좌표 계산 (boardContainer 기준)\n   713\t    let sumX = 0;\n   714\t    let sumY = 0;\n   715\t    const container = document.getElementById('board-container');\n   716\t    const containerRect = container.getBoundingClientRect();\n   717\t\n   718\t    targetTiles.forEach((tile) => {\n   719\t      tile.isCleared = true;\n   720\t      cachedTileRects[tile.index] = null;\n   721\t\n   722\t      const r = tile.el.getBoundingClientRect();\n   723\t      sumX += (r.left + r.width / 2) - containerRect.left;\n   724\t      sumY += (r.top + r.height / 2) - containerRect.top;\n   725\t\n   726\t      // 통통 튀며 터지는 팝 애니메이션 적용\n   727\t      tile.el.classList.remove('selected', 'is-ten');\n   728\t      tile.el.classList.add('clearing-pop');\n   729\t\n   730\t      setTimeout(() => {\n   731\t        tile.el.classList.remove('clearing-pop');\n   732\t        tile.el.classList.add('cleared');\n   733\t      }, 280);\n   734\t    });\n   735\t\n   736\t    const centerX = sumX / count;\n   737\t    const centerY = sumY / count;\n   738\t\n   739\t    // 3. 플로팅 스코어 이펙트 (+N)\n   740\t    spawnFloatingScore(centerX, centerY, `+${count}`);\n   741\t\n   742\t    // 4. HUD 업데이트\n   743\t    updateHud();\n   744\t\n   745\t    // 5. 올클리어 체크 (귤이 0개 남음)\n   746\t    if (remainingCount <= 0) {\n   747\t      endGame(true);\n   748\t    }\n   749\t  }\n   750\t\n   751\t  // 플로팅 점수 텍스트 생성\n   752\t  function spawnFloatingScore(x, y, text) {\n   753\t    const container = document.getElementById('board-container');\n   754\t    const floatEl = document.createElement('div');\n   755\t    floatEl.className = 'floating-score';\n   756\t    floatEl.textContent = text;\n   757\t    floatEl.style.left = `${x}px`;\n   758\t    floatEl.style.top = `${y}px`;\n   759\t\n   760\t    container.appendChild(floatEl);\n   761\t\n   762\t    setTimeout(() => {\n   763\t      if (floatEl.parentNode) {\n   764\t        floatEl.parentNode.removeChild(floatEl);\n   765\t      }\n   766\t    }, 800);\n   767\t  }\n   768\t\n   769\t  // ==========================================================================\n   770\t  // Supabase 랭킹 시스템 (사이드 Top 5 조회 및 신규 기록 등록)\n   771\t  // ==========================================================================\n   772\t  async function fetchTop5Scores(isManual = false) {\n   773\t    if (!supabaseClient) return;\n   774\t\n   775\t    const skeleton = document.getElementById('leaderboard-skeleton');\n   776\t    const top5List = document.getElementById('top5-list');\n   777\t    const emptyView = document.getElementById('top5-empty');\n   778\t    const refreshBtn = document.getElementById('btn-refresh-ranking');\n   779\t\n   780\t    if (refreshBtn) refreshBtn.classList.add('spinning');\n   781\t    if (skeleton) skeleton.style.display = 'flex';\n   782\t    if (top5List) top5List.style.display = 'none';\n   783\t    if (emptyView) emptyView.style.display = 'none';\n   784\t\n   785\t    try {\n   786\t      const { data, error } = await supabaseClient\n   787\t        .from('mandarin-game_scores')\n   788\t        .select('id, nickname, score, remaining_count, play_time, created_at')\n   789\t        .order('score', { ascending: false })\n   790\t        .order('created_at', { ascending: true })\n   791\t        .limit(5);\n   792\t\n   793\t      if (error) throw error;\n   794\t\n   795\t      renderTop5List(data || []);\n   796\t      if (isManual) {\n   797\t        showToast('명예의 전당(Top 5)이 갱신되었습니다. ✨');\n   798\t      }\n   799\t    } catch (err) {\n   800\t      console.error('Top 5 불러오기 실패:', err);\n   801\t      if (isManual) {\n   802\t        showToast('랭킹을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.');\n   803\t      }\n   804\t    } finally {\n   805\t      if (skeleton) skeleton.style.display = 'none';\n   806\t      if (refreshBtn) {\n   807\t        setTimeout(() => refreshBtn.classList.remove('spinning'), 500);\n   808\t      }\n   809\t    }\n   810\t  }\n   811\t\n   812\t  // XSS 원천 차단: DOM 생성 및 textContent 바인딩\n   813\t  function renderTop5List(scores) {\n   814\t    const top5List = document.getElementById('top5-list');\n   815\t    const emptyView = document.getElementById('top5-empty');\n   816\t\n   817\t    if (!scores || scores.length === 0) {\n   818\t      if (top5List) top5List.style.display = 'none';\n   819\t      if (emptyView) emptyView.style.display = 'block';\n   820\t      return;\n   821\t    }\n   822\t\n   823\t    if (emptyView) emptyView.style.display = 'none';\n   824\t    if (top5List) {\n   825\t      top5List.style.display = 'flex';\n   826\t      top5List.innerHTML = '';\n   827\t\n   828\t      scores.forEach((item, index) => {\n   829\t        const rank = index + 1;\n   830\t        const li = document.createElement('li');\n   831\t        li.className = `top5-item rank-${rank}`;\n   832\t        li.dataset.recordId = item.id;\n   833\t\n   834\t        // 좌측 순위 및 닉네임 그룹\n   835\t        const rankCol = document.createElement('div');\n   836\t        rankCol.className = 'top5-rank-col';\n   837\t\n   838\t        // 메달/배지\n   839\t        const badgeSpan = document.createElement('span');\n   840\t        if (rank === 1) {\n   841\t          badgeSpan.className = 'rank-badge gold';\n   842\t          badgeSpan.textContent = '🥇 1st';\n   843\t        } else if (rank === 2) {\n   844\t          badgeSpan.className = 'rank-badge silver';\n   845\t          badgeSpan.textContent = '🥈 2nd';\n   846\t        } else if (rank === 3) {\n   847\t          badgeSpan.className = 'rank-badge bronze';\n   848\t          badgeSpan.textContent = '🥉 3rd';\n   849\t        } else {\n   850\t          badgeSpan.className = 'rank-badge normal';\n   851\t          badgeSpan.textContent = `${rank}th`;\n   852\t        }\n   853\t        rankCol.appendChild(badgeSpan);\n   854\t\n   855\t        // 플레이어 정보 (textContent로 XSS 원천 차단)\n   856\t        const playerInfo = document.createElement('div');\n   857\t        playerInfo.className = 'player-info';\n   858\t\n   859\t        const nameSpan = document.createElement('span');\n   860\t        nameSpan.className = 'player-name';\n   861\t        nameSpan.textContent = item.nickname || '익명';\n   862\t        nameSpan.setAttribute('title', item.nickname || '익명');\n   863\t\n   864\t        const timeSpan = document.createElement('span');\n   865\t        timeSpan.className = 'record-time';\n   866\t        timeSpan.textContent = formatTimeAgo(item.created_at);\n   867\t\n   868\t        playerInfo.appendChild(nameSpan);\n   869\t        playerInfo.appendChild(timeSpan);\n   870\t        rankCol.appendChild(playerInfo);\n   871\t\n   872\t        // 우측 스코어 그룹\n   873\t        const scoreCol = document.createElement('div');\n   874\t        scoreCol.className = 'top5-score-col';\n   875\t\n   876\t        const scoreValSpan = document.createElement('span');\n   877\t        scoreValSpan.className = 'score-val';\n   878\t        scoreValSpan.textContent = String(item.score);\n   879\t\n   880\t        const scoreUnitSpan = document.createElement('span');\n   881\t        scoreUnitSpan.className = 'score-unit';\n   882\t        scoreUnitSpan.textContent = '점';\n   883\t\n   884\t        scoreCol.appendChild(scoreValSpan);\n   885\t        scoreCol.appendChild(scoreUnitSpan);\n   886\t\n   887\t        li.appendChild(rankCol);\n   888\t        li.appendChild(scoreCol);\n   889\t        top5List.appendChild(li);\n   890\t      });\n   891\t    }\n   892\t  }\n   893\t\n   894\t  // 점수 등록 핸들러 (어뷰징 방지, 허니팟, 중복 방지)\n   895\t  async function handleScoreSubmit(e) {\n   896\t    e.preventDefault();\n   897\t    if (!supabaseClient) {\n   898\t      showToast('데이터베이스에 연결할 수 없습니다.');\n   899\t      return;\n   900\t    }\n   901\t\n   902\t    // 1. 봇 허니팟 검증 (hidden 필드에 값이 입력되어 있으면 매크로로 간주하고 차단)\n   903\t    const honeypot = document.getElementById('honeypot-game-website');\n   904\t    if (honeypot && honeypot.value.trim() !== '') {\n   905\t      console.warn('Bot detected by honeypot.');\n   906\t      closeModal();\n   907\t      return;\n   908\t    }\n   909\t\n   910\t    // 2. 1게임 1회 등록 원칙 (중복 등록 차단)\n   911\t    if (hasSubmittedThisGame) {\n   912\t      showToast('이미 이번 게임의 점수가 등록되었습니다. 새 게임에 도전해 보세요!');\n   913\t      closeModal();\n   914\t      return;\n   915\t    }\n   916\t\n   917\t    // 3. 도배 방지 쿨다운 검증 (10초)\n   918\t    const now = Date.now();\n   919\t    if (now - lastSubmitTimestamp < SUBMIT_COOLDOWN_MS) {\n   920\t      const waitSec = Math.ceil((SUBMIT_COOLDOWN_MS - (now - lastSubmitTimestamp)) / 1000);\n   921\t      showToast(`도배 방지를 위해 ${waitSec}초 후에 다시 시도해 주세요.`);\n   922\t      return;\n   923\t    }\n   924\t\n   925\t    const nickInput = document.getElementById('player-nickname');\n   926\t    const submitBtn = document.getElementById('btn-submit-score');\n   927\t    const rawNickname = (nickInput.value || '').trim();\n   928\t\n   929\t    // 4. 닉네임 유효성 검사\n   930\t    if (!rawNickname || rawNickname.length < 1) {\n   931\t      showToast('닉네임을 1글자 이상 입력해 주세요.');\n   932\t      nickInput.focus();\n   933\t      return;\n   934\t    }\n   935\t\n   936\t    if (rawNickname.length > 20) {\n   937\t      showToast('닉네임은 최대 20자까지 가능합니다.');\n   938\t      return;\n   939\t    }\n   940\t\n   941\t    // 5. 점수 및 플레이 시간 무결성 검증\n   942\t    if (score < 0 || score > 220) {\n   943\t      showToast('비정상적인 점수 데이터입니다.');\n   944\t      return;\n   945\t    }\n   946\t\n   947\t    const playDuration = Math.max(1, Math.min(GAME_DURATION, Math.round((Date.now() - (gameStartTime || Date.now())) / 1000)));\n   948\t\n   949\t    // 버튼 로딩 상태\n   950\t    setButtonLoading(submitBtn, true);\n   951\t\n   952\t    try {\n   953\t      const { data, error } = await supabaseClient\n   954\t        .from('mandarin-game_scores')\n   955\t        .insert([\n   956\t          {\n   957\t            nickname: rawNickname,\n   958\t            score: score,\n   959\t            remaining_count: remainingCount,\n   960\t            play_time: playDuration\n   961\t          }\n   962\t        ])\n   963\t        .select();\n   964\t\n   965\t      if (error) throw error;\n   966\t\n   967\t      hasSubmittedThisGame = true; // 이번 세션 등록 완료\n   968\t      lastSubmitTimestamp = Date.now();\n   969\t\n   970\t      // 로컬 스토리지에 마지막 닉네임 저장\n   971\t      localStorage.setItem('mandarin_player_nickname', rawNickname);\n   972\t\n   973\t      showToast(`🎉 ${rawNickname}님의 점수(${score}점)가 명예의 전당에 등록되었습니다!`);\n   974\t      closeModal();\n   975\t\n   976\t      // 사이드 Top 5 즉각 갱신\n   977\t      await fetchTop5Scores();\n   978\t\n   979\t      // 등록된 기록이 5위 내에 있다면 하이라이트\n   980\t      if (data && data[0]) {\n   981\t        highlightLeaderboardItem(data[0].id);\n   982\t      }\n   983\t    } catch (err) {\n   984\t      console.error('점수 등록 오류:', err);\n   985\t      showToast('점수 등록 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.');\n   986\t    } finally {\n   987\t      setButtonLoading(submitBtn, false);\n   988\t    }\n   989\t  }\n   990\t\n   991\t  function highlightLeaderboardItem(recordId) {\n   992\t    setTimeout(() => {\n   993\t      const el = document.querySelector(`.top5-item[data-record-id=\"${recordId}\"]`);\n   994\t      if (el) {\n   995\t        el.classList.add('newly-ranked');\n   996\t        soundManager.playSuccessChime();\n   997\t      }\n   998\t    }, 200);\n   999\t  }\n  1000\t\n  1001\t  function updateMyLastScore(scoreVal) {\n  1002\t    const card = document.getElementById('my-last-score-card');\n  1003\t    const scoreEl = document.getElementById('my-last-score');\n  1004\t    if (card && scoreEl) {\n  1005\t      scoreEl.textContent = String(scoreVal);\n  1006\t      card.style.display = 'block';\n  1007\t    }\n  1008\t  }\n  1009\t\n  1010\t  // ==========================================================================\n  1011\t  // 유틸리티 함수\n  1012\t  // ==========================================================================\n  1013\t  function setButtonLoading(button, isLoading) {\n  1014\t    if (!button) return;\n  1015\t    const textEl = button.querySelector('.btn-text');\n  1016\t    const loaderEl = button.querySelector('.btn-loader');\n  1017\t\n  1018\t    button.disabled = isLoading;\n  1019\t    if (isLoading) {\n  1020\t      if (textEl) textEl.style.display = 'none';\n  1021\t      if (loaderEl) loaderEl.style.display = 'inline-block';\n  1022\t    } else {\n  1023\t      if (textEl) textEl.style.display = 'inline';\n  1024\t      if (loaderEl) loaderEl.style.display = 'none';\n  1025\t    }\n  1026\t  }\n  1027\t\n  1028\t  function showToast(msg) {\n  1029\t    const container = document.getElementById('game-toast-container');\n  1030\t    if (!container) return;\n  1031\t\n  1032\t    const toast = document.createElement('div');\n  1033\t    toast.className = 'game-toast';\n  1034\t    toast.textContent = msg;\n  1035\t\n  1036\t    container.appendChild(toast);\n  1037\t\n  1038\t    setTimeout(() => {\n  1039\t      toast.classList.add('show');\n  1040\t    }, 10);\n  1041\t\n  1042\t    setTimeout(() => {\n  1043\t      toast.classList.remove('show');\n  1044\t      setTimeout(() => {\n  1045\t        if (toast.parentNode) toast.parentNode.removeChild(toast);\n  1046\t      }, 300);\n  1047\t    }, 3200);\n  1048\t  }\n  1049\t\n  1050\t  function formatTimeAgo(isoString) {\n  1051\t    if (!isoString) return '';\n  1052\t    const date = new Date(isoString);\n  1053\t    const now = new Date();\n  1054\t    const diffSec = Math.floor((now - date) / 1000);\n  1055\t\n  1056\t    if (diffSec < 60) return '방금 전';\n  1057\t    const diffMin = Math.floor(diffSec / 60);\n  1058\t    if (diffMin < 60) return `${diffMin}분 전`;\n  1059\t    const diffHour = Math.floor(diffMin / 60);\n  1060\t    if (diffHour < 24) return `${diffHour}시간 전`;\n  1061\t    const diffDay = Math.floor(diffHour / 24);\n  1062\t    if (diffDay < 7) return `${diffDay}일 전`;\n  1063\t\n  1064\t    const y = date.getFullYear();\n  1065\t    const m = String(date.getMonth() + 1).padStart(2, '0');\n  1066\t    const d = String(date.getDate()).padStart(2, '0');\n  1067\t    return `${y}.${m}.${d}`;\n  1068\t  }\n  1069\t\n  1070\t  function debounce(fn, delay) {\n  1071\t    let timer = null;\n  1072\t    return function (...args) {\n  1073\t      if (timer) clearTimeout(timer);\n  1074\t      timer = setTimeout(() => fn.apply(this, args), delay);\n  1075\t    };\n  1076\t  }\n  1077\t})();","is_error":false}]},"parent_tool_use_id":null,"session_id":"09927887-7d6c-4638-bf3b-57389993334a","uuid":"5ff6cc24-bb77-4823-922b-9c512b312a4e","timestamp":"2026-11-06T06:30:52.331Z","tool_use_result":{"stdout":"   400\t      if (nickInput) {\n   401\t        setTimeout(() => nickInput.focus(), 200);\n   402\t      }\n   403\t    }\n   404\t\n   405\t    document.getElementById('btn-action-text').textContent = '🎮 게임 시작';\n   406\t  }\n   407\t\n   408\t  function closeModal() {\n   409\t    const modal = document.getElementById('game-modal');\n   410\t    if (modal) modal.style.display = 'none';\n   411\t  }\n   412\t\n   413\t  function updateHud() {\n   414\t    const scoreVal = document.getElementById('hud-score');\n   415\t    const remainingVal = document.getElementById('hud-remaining');\n   416\t    const timerVal = document.getElementById('hud-timer');\n   417\t\n   418\t    if (scoreVal) scoreVal.innerHTML = `${score}<span class=\"stat-unit\">점</span>`;\n   419\t    if (remainingVal) remainingVal.innerHTML = `${remainingCount}<span class=\"stat-unit\">개</span>`;\n   420\t    if (timerVal) timerVal.innerHTML = `${timeLeft}<span class=\"stat-unit\">s</span>`;\n   421\t  }\n   422\t\n   423\t  // ==========================================================================\n   424\t  // 보드 생성 알고리즘 (17x10 = 170개 만다린 타일)\n   425\t  // ==========================================================================\n   426\t  function generateBoard() {\n   427\t    const board = document.getElementById('mandarin-board');\n   428\t    board.innerHTML = '';\n   429\t    tilesData = [];\n   430\t    selectedTileIndexes.clear();\n   431\t\n   432\t    // 1~9 사이의 숫자를 무작위 배정\n   433\t    const fragment = document.createDocumentFragment();\n   434\t\n   435\t    for (let idx = 0; idx < TOTAL_TILES; idx++) {\n   436\t      const row = Math.floor(idx / BOARD_COLS);\n   437\t      const col = idx % BOARD_COLS;\n   438\t      const val = Math.floor(Math.random() * 9) + 1;\n   439\t\n   440\t      const tileEl = document.createElement('div');\n   441\t      tileEl.className = 'mandarin-tile';\n   442\t      tileEl.dataset.index = idx;\n   443\t      tileEl.dataset.row = row;\n   444\t      tileEl.dataset.col = col;\n   445\t      tileEl.dataset.val = val;\n   446\t\n   447\t      tileEl.innerHTML = `\n   448\t        <img src=\"images/mandarin.png\" alt=\"귤\" class=\"tile-bg-mandarin\" draggable=\"false\">\n   449\t        <span class=\"tile-number\">${val}</span>\n   450\t      `;\n   451\t\n   452\t      fragment.appendChild(tileEl);\n   453\t\n   454\t      tilesData.push({\n   455\t        index: idx,\n   456\t        row,\n   457\t        col,\n   458\t        value: val,\n   459\t        isCleared: false,\n   460\t        el: tileEl\n   461\t      });\n   462\t    }\n   463\t\n   464\t    board.appendChild(fragment);\n   465\t  }\n   466\t\n   467\t  // 성능 최적화: boardContainer 기준으로 타일 BoundingBox 캐싱\n   468\t  function cacheTileBoundingBoxes() {\n   469\t    const container = document.getElementById('board-container');\n   470\t    if (!container) return;\n   471\t    const containerRect = container.getBoundingClientRect();\n   472\t\n   473\t    cachedTileRects = tilesData.map((tile) => {\n   474\t      if (tile.isCleared) return null;\n   475\t      const r = tile.el.getBoundingClientRect();\n   476\t      return {\n   477\t        left: r.left - containerRect.left,\n   478\t        top: r.top - containerRect.top,\n   479\t        right: r.right - containerRect.left,\n   480\t        bottom: r.bottom - containerRect.top,\n   481\t        width: r.width,\n   482\t        height: r.height\n   483\t      };\n   484\t    });\n   485\t  }\n   486\t\n   487\t  // ==========================================================================\n   488\t  // 드래그 인터랙션 & 합계 10 판정 (Desktop Mouse & Mobile Touch 지원)\n   489\t  // ==========================================================================\n   490\t  function initDragEvents(boardContainer) {\n   491\t    const selectionBox = document.getElementById('selection-box');\n   492\t    const sumBadge = document.getElementById('sum-badge');\n   493\t    const sumBadgeVal = document.getElementById('sum-badge-val');\n   494\t\n   495\t    function getPointerPos(e) {\n   496\t      const containerRect = boardContainer.getBoundingClientRect();\n   497\t      let clientX, clientY;\n   498\t\n   499\t      if (e.touches && e.touches.length > 0) {\n   500\t        clientX = e.touches[0].clientX;\n   501\t        clientY = e.touches[0].clientY;\n   502\t      } else if (e.changedTouches && e.changedTouches.length > 0) {\n   503\t        clientX = e.changedTouches[0].clientX;\n   504\t        clientY = e.changedTouches[0].clientY;\n   505\t      } else {\n   506\t        clientX = e.clientX;\n   507\t        clientY = e.clientY;\n   508\t      }\n   509\t\n   510\t      return {\n   511\t        x: clientX - containerRect.left,\n   512\t        y: clientY - containerRect.top,\n   513\t        rawClientX: clientX,\n   514\t        rawClientY: clientY\n   515\t      };\n   516\t    }\n   517\t\n   518\t    // 드래그 시작 핸들러\n   519\t    function onDragStart(e) {\n   520\t      if (!isGameRunning) return;\n   521\t      // 터치 시 스크롤 방지\n   522\t      if (e.type === 'touchstart') {\n   523\t        e.preventDefault();\n   524\t      }\n   525\t\n   526\t      isDragging = true;\n   527\t      const pos = getPointerPos(e);\n   528\t      dragStartX = pos.x;\n   529\t      dragStartY = pos.y;\n   530\t\n   531\t      selectionBox.style.display = 'block';\n   532\t      selectionBox.style.left = `${dragStartX}px`;\n   533\t      selectionBox.style.top = `${dragStartY}px`;\n   534\t      selectionBox.style.width = '0px';\n   535\t      selectionBox.style.height = '0px';\n   536\t      selectionBox.classList.remove('is-ten');\n   537\t\n   538\t      sumBadge.style.display = 'block';\n   539\t      sumBadge.classList.remove('is-ten');\n   540\t      sumBadgeVal.textContent = '0';\n   541\t\n   542\t      selectedTileIndexes.clear();\n   543\t      updateTileSelection(dragStartX, dragStartY, dragStartX, dragStartY);\n   544\t    }\n   545\t\n   546\t    // 드래그 이동 핸들러\n   547\t    function onDragMove(e) {\n   548\t      if (!isDragging || !isGameRunning) return;\n   549\t      if (e.type === 'touchmove') {\n   550\t        e.preventDefault();\n   551\t      }\n   552\t\n   553\t      const pos = getPointerPos(e);\n   554\t      const curX = pos.x;\n   555\t      const curY = pos.y;\n   556\t\n   557\t      const left = Math.min(dragStartX, curX);\n   558\t      const top = Math.min(dragStartY, curY);\n   559\t      const width = Math.abs(curX - dragStartX);\n   560\t      const height = Math.abs(curY - dragStartY);\n   561\t\n   562\t      selectionBox.style.left = `${left}px`;\n   563\t      selectionBox.style.top = `${top}px`;\n   564\t      selectionBox.style.width = `${width}px`;\n   565\t      selectionBox.style.height = `${height}px`;\n   566\t\n   567\t      // 합계 배지 위치\n   568\t      sumBadge.style.left = `${curX + 15}px`;\n   569\t      sumBadge.style.top = `${curY - 30}px`;\n   570\t\n   571\t      // 타일 충돌 검사 및 합계 산출\n   572\t      updateTileSelection(left, top, left + width, top + height);\n   573\t    }\n   574\t\n   575\t    // 드래그 종료 핸들러\n   576\t    function onDragEnd(e) {\n   577\t      if (!isDragging) return;\n   578\t      isDragging = false;\n   579\t\n   580\t      selectionBox.style.display = 'none';\n   581\t      selectionBox.classList.remove('is-ten');\n   582\t      sumBadge.style.display = 'none';\n   583\t      sumBadge.classList.remove('is-ten');\n   584\t\n   585\t      if (!isGameRunning) {\n   586\t        clearSelectionVisuals();\n   587\t        return;\n   588\t      }\n   589\t\n   590\t      // 합계 검사\n   591\t      let sum = 0;\n   592\t      const targets = [];\n   593\t      selectedTileIndexes.forEach((idx) => {\n   594\t        const tile = tilesData[idx];\n   595\t        if (tile && !tile.isCleared) {\n   596\t          sum += tile.value;\n   597\t          targets.push(tile);\n   598\t        }\n   599\t      });\n   600\t\n   601\t      if (sum === 10 && targets.length > 0) {\n   602\t        // 🍊 성공: 합계가 10!\n   603\t        handleSuccessClear(targets);\n   604\t      } else {\n   605\t        // 실패: 합이 10이 아님 -> Shake 연출 후 선택 해제\n   606\t        if (targets.length > 0) {\n   607\t          targets.forEach((t) => {\n   608\t            t.el.classList.add('shake-fail');\n   609\t            setTimeout(() => {\n   610\t              t.el.classList.remove('shake-fail');\n   611\t              t.el.classList.remove('selected');\n   612\t              t.el.classList.remove('is-ten');\n   613\t            }, 300);\n   614\t          });\n   615\t        }\n   616\t      }\n   617\t\n   618\t      selectedTileIndexes.clear();\n   619\t    }\n   620\t\n   621\t    // 타일 충돌 검사 함수 (AABB 박스 충돌)\n   622\t    function updateTileSelection(boxLeft, boxTop, boxRight, boxBottom) {\n   623\t      let currentSum = 0;\n   624\t      const newlySelected = new Set();\n   625\t\n   626\t      for (let i = 0; i < TOTAL_TILES; i++) {\n   627\t        const tile = tilesData[i];\n   628\t        if (!tile || tile.isCleared) continue;\n   629\t\n   630\t        const rect = cachedTileRects[i];\n   631\t        if (!rect) continue;\n   632\t\n   633\t        const isOverlap =\n   634\t          rect.right > boxLeft &&\n   635\t          rect.left < boxRight &&\n   636\t          rect.bottom > boxTop &&\n   637\t          rect.top < boxBottom;\n   638\t\n   639\t        if (isOverlap) {\n   640\t          newlySelected.add(i);\n   641\t          currentSum += tile.value;\n   642\t        }\n   643\t      }\n   644\t\n   645\t      // 클래스 토글\n   646\t      for (let i = 0; i < TOTAL_TILES; i++) {\n   647\t        const tile = tilesData[i];\n   648\t        if (!tile || tile.isCleared) continue;\n   649\t\n   650\t        const isNowSelected = newlySelected.has(i);\n   651\t        if (isNowSelected) {\n   652\t          tile.el.classList.add('selected');\n   653\t        } else {\n   654\t          tile.el.classList.remove('selected');\n   655\t          tile.el.classList.remove('is-ten');\n   656\t        }\n   657\t      }\n   658\t\n   659\t      selectedTileIndexes = newlySelected;\n   660\t\n   661\t      // 합계 10 도달 여부 시각화\n   662\t      if (currentSum === 10) {\n   663\t        selectionBox.classList.add('is-ten');\n   664\t        sumBadge.classList.add('is-ten');\n   665\t        sumBadgeVal.textContent = '10 ✨';\n   666\t        selectedTileIndexes.forEach((idx) => {\n   667\t          tilesData[idx].el.classList.add('is-ten');\n   668\t        });\n   669\t      } else {\n   670\t        selectionBox.classList.remove('is-ten');\n   671\t        sumBadge.classList.remove('is-ten');\n   672\t        sumBadgeVal.textContent = currentSum;\n   673\t        selectedTileIndexes.forEach((idx) => {\n   674\t          tilesData[idx].el.classList.remove('is-ten');\n   675\t        });\n   676\t      }\n   677\t    }\n   678\t\n   679\t    function clearSelectionVisuals() {\n   680\t      tilesData.forEach((t) => {\n   681\t        if (t && t.el) {\n   682\t          t.el.classList.remove('selected', 'is-ten', 'shake-fail');\n   683\t        }\n   684\t      });\n   685\t      selectedTileIndexes.clear();\n   686\t    }\n   687\t\n   688\t    // 마우스 이벤트 등록\n   689\t    boardContainer.addEventListener('mousedown', onDragStart);\n   690\t    window.addEventListener('mousemove', onDragMove);\n   691\t    window.addEventListener('mouseup', onDragEnd);\n   692\t\n   693\t    // 터치 이벤트 등록 (모바일)\n   694\t    boardContainer.addEventListener('touchstart', onDragStart, { passive: false });\n   695\t    window.addEventListener('touchmove', onDragMove, { passive: false });\n   696\t    window.addEventListener('touchend', onDragEnd);\n   697\t    window.addEventListener('touchcancel', onDragEnd);\n   698\t  }\n   699\t\n   700\t  // ==========================================================================\n   701\t  // 합계 10 완성 시 타일 제거 & Pop 애니메이션 & 스코어링\n   702\t  // ==========================================================================\n   703\t  function handleSuccessClear(targetTiles) {\n   704\t    const count = targetTiles.length;\n   705\t    score += count;\n   706\t    remainingCount -= count;\n   707\t\n   708\t    // 1. Pop 사운드 효과음 재생\n   709\t    soundManager.playPop(1.0 + (count * 0.05));\n   710\t    soundManager.playSuccessChime();\n   711\t\n   712\t    // 2. 중심 좌표 계산 (boardContainer 기준)\n   713\t    let sumX = 0;\n   714\t    let sumY = 0;\n   715\t    const container = document.getElementById('board-container');\n   716\t    const containerRect = container.getBoundingClientRect();\n   717\t\n   718\t    targetTiles.forEach((tile) => {\n   719\t      tile.isCleared = true;\n   720\t      cachedTileRects[tile.index] = null;\n   721\t\n   722\t      const r = tile.el.getBoundingClientRect();\n   723\t      sumX += (r.left + r.width / 2) - containerRect.left;\n   724\t      sumY += (r.top + r.height / 2) - containerRect.top;\n   725\t\n   726\t      // 통통 튀며 터지는 팝 애니메이션 적용\n   727\t      tile.el.classList.remove('selected', 'is-ten');\n   728\t      tile.el.classList.add('clearing-pop');\n   729\t\n   730\t      setTimeout(() => {\n   731\t        tile.el.classList.remove('clearing-pop');\n   732\t        tile.el.classList.add('cleared');\n   733\t      }, 280);\n   734\t    });\n   735\t\n   736\t    const centerX = sumX / count;\n   737\t    const centerY = sumY / count;\n   738\t\n   739\t    // 3. 플로팅 스코어 이펙트 (+N)\n   740\t    spawnFloatingScore(centerX, centerY, `+${count}`);\n   741\t\n   742\t    // 4. HUD 업데이트\n   743\t    updateHud();\n   744\t\n   745\t    // 5. 올클리어 체크 (귤이 0개 남음)\n   746\t    if (remainingCount <= 0) {\n   747\t      endGame(true);\n   748\t    }\n   749\t  }\n   750\t\n   751\t  // 플로팅 점수 텍스트 생성\n   752\t  function spawnFloatingScore(x, y, text) {\n   753\t    const container = document.getElementById('board-container');\n   754\t    const floatEl = document.createElement('div');\n   755\t    floatEl.className = 'floating-score';\n   756\t    floatEl.textContent = text;\n   757\t    floatEl.style.left = `${x}px`;\n   758\t    floatEl.style.top = `${y}px`;\n   759\t\n   760\t    container.appendChild(floatEl);\n   761\t\n   762\t    setTimeout(() => {\n   763\t      if (floatEl.parentNode) {\n   764\t        floatEl.parentNode.removeChild(floatEl);\n   765\t      }\n   766\t    }, 800);\n   767\t  }\n   768\t\n   769\t  // ==========================================================================\n   770\t  // Supabase 랭킹 시스템 (사이드 Top 5 조회 및 신규 기록 등록)\n   771\t  // ==========================================================================\n   772\t  async function fetchTop5Scores(isManual = false) {\n   773\t    if (!supabaseClient) return;\n   774\t\n   775\t    const skeleton = document.getElementById('leaderboard-skeleton');\n   776\t    const top5List = document.getElementById('top5-list');\n   777\t    const emptyView = document.getElementById('top5-empty');\n   778\t    const refreshBtn = document.getElementById('btn-refresh-ranking');\n   779\t\n   780\t    if (refreshBtn) refreshBtn.classList.add('spinning');\n   781\t    if (skeleton) skeleton.style.display = 'flex';\n   782\t    if (top5List) top5List.style.display = 'none';\n   783\t    if (emptyView) emptyView.style.display = 'none';\n   784\t\n   785\t    try {\n   786\t      const { data, error } = await supabaseClient\n   787\t        .from('mandarin-game_scores')\n   788\t        .select('id, nickname, score, remaining_count, play_time, created_at')\n   789\t        .order('score', { ascending: false })\n   790\t        .order('created_at', { ascending: true })\n   791\t        .limit(5);\n   792\t\n   793\t      if (error) throw error;\n   794\t\n   795\t      renderTop5List(data || []);\n   796\t      if (isManual) {\n   797\t        showToast('명예의 전당(Top 5)이 갱신되었습니다. ✨');\n   798\t      }\n   799\t    } catch (err) {\n   800\t      console.error('Top 5 불러오기 실패:', err);\n   801\t      if (isManual) {\n   802\t        showToast('랭킹을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.');\n   803\t      }\n   804\t    } finally {\n   805\t      if (skeleton) skeleton.style.display = 'none';\n   806\t      if (refreshBtn) {\n   807\t        setTimeout(() => refreshBtn.classList.remove('spinning'), 500);\n   808\t      }\n   809\t    }\n   810\t  }\n   811\t\n   812\t  // XSS 원천 차단: DOM 생성 및 textContent 바인딩\n   813\t  function renderTop5List(scores) {\n   814\t    const top5List = document.getElementById('top5-list');\n   815\t    const emptyView = document.getElementById('top5-empty');\n   816\t\n   817\t    if (!scores || scores.length === 0) {\n   818\t      if (top5List) top5List.style.display = 'none';\n   819\t      if (emptyView) emptyView.style.display = 'block';\n   820\t      return;\n   821\t    }\n   822\t\n   823\t    if (emptyView) emptyView.style.display = 'none';\n   824\t    if (top5List) {\n   825\t      top5List.style.display = 'flex';\n   826\t      top5List.innerHTML = '';\n   827\t\n   828\t      scores.forEach((item, index) => {\n   829\t        const rank = index + 1;\n   830\t        const li = document.createElement('li');\n   831\t        li.className = `top5-item rank-${rank}`;\n   832\t        li.dataset.recordId = item.id;\n   833\t\n   834\t        // 좌측 순위 및 닉네임 그룹\n   835\t        const rankCol = document.createElement('div');\n   836\t        rankCol.className = 'top5-rank-col';\n   837\t\n   838\t        // 메달/배지\n   839\t        const badgeSpan = document.createElement('span');\n   840\t        if (rank === 1) {\n   841\t          badgeSpan.className = 'rank-badge gold';\n   842\t          badgeSpan.textContent = '🥇 1st';\n   843\t        } else if (rank === 2) {\n   844\t          badgeSpan.className = 'rank-badge silver';\n   845\t          badgeSpan.textContent = '🥈 2nd';\n   846\t        } else if (rank === 3) {\n   847\t          badgeSpan.className = 'rank-badge bronze';\n   848\t          badgeSpan.textContent = '🥉 3rd';\n   849\t        } else {\n   850\t          badgeSpan.className = 'rank-badge normal';\n   851\t          badgeSpan.textContent = `${rank}th`;\n   852\t        }\n   853\t        rankCol.appendChild(badgeSpan);\n   854\t\n   855\t        // 플레이어 정보 (textContent로 XSS 원천 차단)\n   856\t        const playerInfo = document.createElement('div');\n   857\t        playerInfo.className = 'player-info';\n   858\t\n   859\t        const nameSpan = document.createElement('span');\n   860\t        nameSpan.className = 'player-name';\n   861\t        nameSpan.textContent = item.nickname || '익명';\n   862\t        nameSpan.setAttribute('title', item.nickname || '익명');\n   863\t\n   864\t        const timeSpan = document.createElement('span');\n   865\t        timeSpan.className = 'record-time';\n   866\t        timeSpan.textContent = formatTimeAgo(item.created_at);\n   867\t\n   868\t        playerInfo.appendChild(nameSpan);\n   869\t        playerInfo.appendChild(timeSpan);\n   870\t        rankCol.appendChild(playerInfo);\n   871\t\n   872\t        // 우측 스코어 그룹\n   873\t        const scoreCol = document.createElement('div');\n   874\t        scoreCol.className = 'top5-score-col';\n   875\t\n   876\t        const scoreValSpan = document.createElement('span');\n   877\t        scoreValSpan.className = 'score-val';\n   878\t        scoreValSpan.textContent = String(item.score);\n   879\t\n   880\t        const scoreUnitSpan = document.createElement('span');\n   881\t        scoreUnitSpan.className = 'score-unit';\n   882\t        scoreUnitSpan.textContent = '점';\n   883\t\n   884\t        scoreCol.appendChild(scoreValSpan);\n   885\t        scoreCol.appendChild(scoreUnitSpan);\n   886\t\n   887\t        li.appendChild(rankCol);\n   888\t        li.appendChild(scoreCol);\n   889\t        top5List.appendChild(li);\n   890\t      });\n   891\t    }\n   892\t  }\n   893\t\n   894\t  // 점수 등록 핸들러 (어뷰징 방지, 허니팟, 중복 방지)\n   895\t  async function handleScoreSubmit(e) {\n   896\t    e.preventDefault();\n   897\t    if (!supabaseClient) {\n   898\t      showToast('데이터베이스에 연결할 수 없습니다.');\n   899\t      return;\n   900\t    }\n   901\t\n   902\t    // 1. 봇 허니팟 검증 (hidden 필드에 값이 입력되어 있으면 매크로로 간주하고 차단)\n   903\t    const honeypot = document.getElementById('honeypot-game-website');\n   904\t    if (honeypot && honeypot.value.trim() !== '') {\n   905\t      console.warn('Bot detected by honeypot.');\n   906\t      closeModal();\n   907\t      return;\n   908\t    }\n   909\t\n   910\t    // 2. 1게임 1회 등록 원칙 (중복 등록 차단)\n   911\t    if (hasSubmittedThisGame) {\n   912\t      showToast('이미 이번 게임의 점수가 등록되었습니다. 새 게임에 도전해 보세요!');\n   913\t      closeModal();\n   914\t      return;\n   915\t    }\n   916\t\n   917\t    // 3. 도배 방지 쿨다운 검증 (10초)\n   918\t    const now = Date.now();\n   919\t    if (now - lastSubmitTimestamp < SUBMIT_COOLDOWN_MS) {\n   920\t      const waitSec = Math.ceil((SUBMIT_COOLDOWN_MS - (now - lastSubmitTimestamp)) / 1000);\n   921\t      showToast(`도배 방지를 위해 ${waitSec}초 후에 다시 시도해 주세요.`);\n   922\t      return;\n   923\t    }\n   924\t\n   925\t    const nickInput = document.getElementById('player-nickname');\n   926\t    const submitBtn = document.getElementById('btn-submit-score');\n   927\t    const rawNickname = (nickInput.value || '').trim();\n   928\t\n   929\t    // 4. 닉네임 유효성 검사\n   930\t    if (!rawNickname || rawNickname.length < 1) {\n   931\t      showToast('닉네임을 1글자 이상 입력해 주세요.');\n   932\t      nickInput.focus();\n   933\t      return;\n   934\t    }\n   935\t\n   936\t    if (rawNickname.length > 20) {\n   937\t      showToast('닉네임은 최대 20자까지 가능합니다.');\n   938\t      return;\n   939\t    }\n   940\t\n   941\t    // 5. 점수 및 플레이 시간 무결성 검증\n   942\t    if (score < 0 || score > 220) {\n   943\t      showToast('비정상적인 점수 데이터입니다.');\n   944\t      return;\n   945\t    }\n   946\t\n   947\t    const playDuration = Math.max(1, Math.min(GAME_DURATION, Math.round((Date.now() - (gameStartTime || Date.now())) / 1000)));\n   948\t\n   949\t    // 버튼 로딩 상태\n   950\t    setButtonLoading(submitBtn, true);\n   951\t\n   952\t    try {\n   953\t      const { data, error } = await supabaseClient\n   954\t        .from('mandarin-game_scores')\n   955\t        .insert([\n   956\t          {\n   957\t            nickname: rawNickname,\n   958\t            score: score,\n   959\t            remaining_count: remainingCount,\n   960\t            play_time: playDuration\n   961\t          }\n   962\t        ])\n   963\t        .select();\n   964\t\n   965\t      if (error) throw error;\n   966\t\n   967\t      hasSubmittedThisGame = true; // 이번 세션 등록 완료\n   968\t      lastSubmitTimestamp = Date.now();\n   969\t\n   970\t      // 로컬 스토리지에 마지막 닉네임 저장\n   971\t      localStorage.setItem('mandarin_player_nickname', rawNickname);\n   972\t\n   973\t      showToast(`🎉 ${rawNickname}님의 점수(${score}점)가 명예의 전당에 등록되었습니다!`);\n   974\t      closeModal();\n   975\t\n   976\t      // 사이드 Top 5 즉각 갱신\n   977\t      await fetchTop5Scores();\n   978\t\n   979\t      // 등록된 기록이 5위 내에 있다면 하이라이트\n   980\t      if (data && data[0]) {\n   981\t        highlightLeaderboardItem(data[0].id);\n   982\t      }\n   983\t    } catch (err) {\n   984\t      console.error('점수 등록 오류:', err);\n   985\t      showToast('점수 등록 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.');\n   986\t    } finally {\n   987\t      setButtonLoading(submitBtn, false);\n   988\t    }\n   989\t  }\n   990\t\n   991\t  function highlightLeaderboardItem(recordId) {\n   992\t    setTimeout(() => {\n   993\t      const el = document.querySelector(`.top5-item[data-record-id=\"${recordId}\"]`);\n   994\t      if (el) {\n   995\t        el.classList.add('newly-ranked');\n   996\t        soundManager.playSuccessChime();\n   997\t      }\n   998\t    }, 200);\n   999\t  }\n  1000\t\n  1001\t  function updateMyLastScore(scoreVal) {\n  1002\t    const card = document.getElementById('my-last-score-card');\n  1003\t    const scoreEl = document.getElementById('my-last-score');\n  1004\t    if (card && scoreEl) {\n  1005\t      scoreEl.textContent = String(scoreVal);\n  1006\t      card.style.display = 'block';\n  1007\t    }\n  1008\t  }\n  1009\t\n  1010\t  // ==========================================================================\n  1011\t  // 유틸리티 함수\n  1012\t  // ==========================================================================\n  1013\t  function setButtonLoading(button, isLoading) {\n  1014\t    if (!button) return;\n  1015\t    const textEl = button.querySelector('.btn-text');\n  1016\t    const loaderEl = button.querySelector('.btn-loader');\n  1017\t\n  1018\t    button.disabled = isLoading;\n  1019\t    if (isLoading) {\n  1020\t      if (textEl) textEl.style.display = 'none';\n  1021\t      if (loaderEl) loaderEl.style.display = 'inline-block';\n  1022\t    } else {\n  1023\t      if (textEl) textEl.style.display = 'inline';\n  1024\t      if (loaderEl) loaderEl.style.display = 'none';\n  1025\t    }\n  1026\t  }\n  1027\t\n  1028\t  function showToast(msg) {\n  1029\t    const container = document.getElementById('game-toast-container');\n  1030\t    if (!container) return;\n  1031\t\n  1032\t    const toast = document.createElement('div');\n  1033\t    toast.className = 'game-toast';\n  1034\t    toast.textContent = msg;\n  1035\t\n  1036\t    container.appendChild(toast);\n  1037\t\n  1038\t    setTimeout(() => {\n  1039\t      toast.classList.add('show');\n  1040\t    }, 10);\n  1041\t\n  1042\t    setTimeout(() => {\n  1043\t      toast.classList.remove('show');\n  1044\t      setTimeout(() => {\n  1045\t        if (toast.parentNode) toast.parentNode.removeChild(toast);\n  1046\t      }, 300);\n  1047\t    }, 3200);\n  1048\t  }\n  1049\t\n  1050\t  function formatTimeAgo(isoString) {\n  1051\t    if (!isoString) return '';\n  1052\t    const date = new Date(isoString);\n  1053\t    const now = new Date();\n  1054\t    const diffSec = Math.floor((now - date) / 1000);\n  1055\t\n  1056\t    if (diffSec < 60) return '방금 전';\n  1057\t    const diffMin = Math.floor(diffSec / 60);\n  1058\t    if (diffMin < 60) return `${diffMin}분 전`;\n  1059\t    const diffHour = Math.floor(diffMin / 60);\n  1060\t    if (diffHour < 24) return `${diffHour}시간 전`;\n  1061\t    const diffDay = Math.floor(diffHour / 24);\n  1062\t    if (diffDay < 7) return `${diffDay}일 전`;\n  1063\t\n  1064\t    const y = date.getFullYear();\n  1065\t    const m = String(date.getMonth() + 1).padStart(2, '0');\n  1066\t    const d = String(date.getDate()).padStart(2, '0');\n  1067\t    return `${y}.${m}.${d}`;\n  1068\t  }\n  1069\t\n  1070\t  function debounce(fn, delay) {\n  1071\t    let timer = null;\n  1072\t    return function (...args) {\n  1073\t      if (timer) clearTimeout(timer);\n  1074\t      timer = setTimeout(() => fn.apply(this, args), delay);\n  1075\t    };\n  1076\t  }\n  1077\t})();","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_019i4fSMo6Pw1EVQFno2BVxf","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
