  "about.html": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>자기소개 | algethi97</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <link rel=\"stylesheet\" href=\"css/pages.css\">\n</head>\n<body class=\"standalone-page\">\n\n  <!-- 상단 네비게이션 헤더 -->\n  <header class=\"nav-header\">\n    <div class=\"nav-inner\">\n      <!-- 좌측 상단: 홈페이지로 돌아오도록 하는 버튼 (픽토그램) -->\n      <a href=\"index.html\" class=\"home-button\" aria-label=\"홈페이지로 돌아가기\" title=\"홈페이지로 돌아가기\">\n        <svg class=\"home-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path>\n          <polyline points=\"9 22 9 12 15 12 15 22\"></polyline>\n        </svg>\n      </a>\n\n      <!-- 4칸짜리 탭 네비게이션 -->\n      <div class=\"tabs-container\">\n        <nav class=\"tabs-grid four-tabs\">\n          <!-- 왼쪽 칸: 자기소개 (현재 활성화된 탭) -->\n          <a href=\"about.html\" class=\"tab-item active\" id=\"tab-about\">\n            👤 자기소개\n          </a>\n          <!-- 중앙 칸: 포트폴리오 -->\n          <a href=\"portfolio.html\" class=\"tab-item\" id=\"tab-portfolio\">\n            💼 포트폴리오\n          </a>\n          <!-- 방명록 -->\n          <a href=\"guestbook.html\" class=\"tab-item\" id=\"tab-guestbook\">\n            📝 방명록\n          </a>\n          <!-- 우측 칸: 만다린 게임 -->\n          <a href=\"game.html\" class=\"tab-item\" id=\"tab-game\">\n            🍊 만다린 게임\n          </a>\n        </nav>\n      </div>\n    </div>\n  </header>\n\n  <!-- 메인 콘텐츠 영역 -->\n  <main class=\"main-content\">\n    <div class=\"page-header\">\n      <h1 class=\"page-title\">About Me 🚀</h1>\n      <p class=\"page-subtitle\">꾸준히 성장하고 가치를 만들고 있는 개발자 지망생입니다.</p>\n    </div>\n\n    <!-- 프로필 요약 카드 -->\n    <section class=\"card\">\n      <div class=\"profile-section\">\n        <div class=\"profile-avatar\">👨‍💻</div>\n        <div style=\"flex: 1;\">\n          <h2>algethi97</h2>\n          <p style=\"color: var(--accent-orange); font-weight: 600; margin-bottom: 0.5rem;\">Architect & Developer</p>\n          <p style=\"color: var(--text-sub); line-height: 1.65;\">\n            새로운 기술을 탐구하고 직관적인 사용자 경험을 디자인하는 것을 좋아합니다.<br>\n            문제를 해결하는 코드와 협업을 통한 시너지를 추구합니다.\n          </p>\n          <div style=\"margin-top: 1rem; display: flex; gap: 0.75rem; flex-wrap: wrap;\">\n            <button type=\"button\" class=\"copy-badge\" data-copy=\"algethi97@gmail.com\" data-message=\"이메일 주소(algethi97@gmail.com)가 복사되었습니다!\" title=\"클릭하여 이메일 주소 복사\">\n              📧 algethi97@gmail.com <span class=\"copy-icon\">📋</span>\n            </button>\n            <a href=\"https://github.com/algethi97\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"copy-badge\">\n              🐙 GitHub 방문\n            </a>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- 보유 기술 스택 카드 -->\n    <section class=\"card\">\n      <h2>🛠️ Skills & Technologies</h2>\n      <div class=\"skills-tags\">\n        <span class=\"skill-tag\">Architect Engineer</span>\n        <span class=\"skill-tag\">C.S. in S. & D. 1st Grade</span>\n        <span class=\"skill-tag\">HTML5</span>\n        <span class=\"skill-tag\">CSS3 / Flexbox / Grid</span>\n        <span class=\"skill-tag\">JavaScript (ES6+)</span>\n        <span class=\"skill-tag\">Python</span>\n        <span class=\"skill-tag\">Git / GitHub</span>\n        <span class=\"skill-tag\">Responsive Web Design</span>\n      </div>\n    </section>\n\n    <!-- 이력 및 경험 카드 -->\n    <section class=\"card\">\n      <h2>🌱 Experience & Journey</h2>\n      <ul style=\"list-style-type: none; margin-top: 1rem; color: var(--text-sub); line-height: 2;\">\n        <li>• <strong>2023:</strong> 건축공학 학사학위 및 건축기사 자격 취득</li>\n        <li>• <strong>2026:</strong> 웹 개발 및 인터랙티브 포트폴리오 프로젝트 진행(예정)</li>\n        <li>• <strong>2026:</strong> 웹 기술 스택(HTML/CSS/JS) 및 다양한 자동화 도구 학습(예정)</li>\n        <li>• <strong>Ongoing:</strong> 문제 해결을 위한 알고리즘 및 오픈소스 기여(예정)</li>\n      </ul>\n    </section>\n\n    <!-- 홈으로 돌아가기 버튼 -->\n    <div style=\"text-align: center; margin-top: 2rem;\">\n      <a href=\"index.html\" style=\"color: var(--accent-orange); font-weight: 600;\">&larr; 홈으로 돌아가기</a>\n    </div>\n  </main>\n\n  <footer class=\"site-footer\">\n    <p>&copy; 2026 algethi97. All rights reserved.</p>\n  </footer>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
  "portfolio.html": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>포트폴리오 | algethi97</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <link rel=\"stylesheet\" href=\"css/pages.css\">\n</head>\n<body class=\"standalone-page\">\n\n  <!-- 상단 네비게이션 헤더 -->\n  <header class=\"nav-header\">\n    <div class=\"nav-inner\">\n      <!-- 좌측 상단: 홈페이지로 돌아오도록 하는 버튼 (픽토그램) -->\n      <a href=\"index.html\" class=\"home-button\" aria-label=\"홈페이지로 돌아가기\" title=\"홈페이지로 돌아가기\">\n        <svg class=\"home-icon\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"></path>\n          <polyline points=\"9 22 9 12 15 12 15 22\"></polyline>\n        </svg>\n      </a>\n\n      <!-- 4칸짜리 탭 네비게이션 -->\n      <div class=\"tabs-container\">\n        <nav class=\"tabs-grid four-tabs\">\n          <!-- 왼쪽 칸: 자기소개 -->\n          <a href=\"about.html\" class=\"tab-item\" id=\"tab-about\">\n            👤 자기소개\n          </a>\n          <!-- 중앙 칸: 포트폴리오 (현재 활성화된 탭) -->\n          <a href=\"portfolio.html\" class=\"tab-item active\" id=\"tab-portfolio\">\n            💼 포트폴리오\n          </a>\n          <!-- 방명록 -->\n          <a href=\"guestbook.html\" class=\"tab-item\" id=\"tab-guestbook\">\n            📝 방명록\n          </a>\n          <!-- 우측 칸: 만다린 게임 -->\n          <a href=\"game.html\" class=\"tab-item\" id=\"tab-game\">\n            🍊 만다린 게임\n          </a>\n        </nav>\n      </div>\n    </div>\n  </header>\n\n  <!-- 메인 콘텐츠 영역 -->\n  <main class=\"main-content\">\n    <div class=\"page-header\">\n      <h1 class=\"page-title\">Featured Projects 💼</h1>\n      <p class=\"page-subtitle\">직접 기획하고 개발한 주요 프로젝트들을 소개합니다.</p>\n    </div>\n\n    <!-- 프로젝트 그리드 -->\n    <div class=\"portfolio-grid\">\n      <!-- 프로젝트 1: Personal Portfolio Website -->\n      <div class=\"project-card\">\n        <div class=\"project-thumbnail\">🌐</div>\n        <div class=\"project-body\">\n          <h3>Personal Portfolio Website</h3>\n          <p>HTML, CSS, JavaScript만을 사용하여 제작한 미니멀하고 반응형인 개인 포트폴리오 웹사이트입니다.</p>\n          <div class=\"skills-tags\" style=\"margin-top: 1rem;\">\n            <span class=\"skill-tag\">HTML5</span>\n            <span class=\"skill-tag\">CSS3</span>\n            <span class=\"skill-tag\">JavaScript</span>\n          </div>\n          <a href=\"https://github.com/algethi97/algethi97.github.io\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn\" style=\"margin-top: 1.4rem;\">저장소로 이동</a>\n        </div>\n      </div>\n\n      <!-- 프로젝트 2: SafeJeonse (세이프전세) -->\n      <div class=\"project-card\">\n        <div class=\"project-thumbnail\">🛡️</div>\n        <div class=\"project-body\">\n          <h3>SafeJeonse (세이프전세)</h3>\n          <p>공공데이터(실거래가 8종·건축물대장·공시가격) 실시간 교차 검증 및 매물 탐색부터 계약, 거주, 만기·퇴거까지 8 Core Moments 임대차 전 생애주기를 보호하는 청년 주거 안심 통합 플랫폼입니다.</p>\n          <div class=\"skills-tags\" style=\"margin-top: 1rem;\">\n            <span class=\"skill-tag\">Python</span>\n            <span class=\"skill-tag\">Streamlit</span>\n            <span class=\"skill-tag\">SQLite</span>\n            <span class=\"skill-tag\">Pandas</span>\n            <span class=\"skill-tag\">Folium</span>\n            <span class=\"skill-tag\">Plotly</span>\n            <span class=\"skill-tag\">OpenAI API</span>\n          </div>\n          <a href=\"https://github.com/algethi97/AIoT-7th_Project-1\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn\" style=\"margin-top: 1.4rem;\">저장소로 이동</a>\n        </div>\n      </div>\n\n      <!-- 프로젝트 3: 만다린 게임 (웹 퍼즐 게임) -->\n      <div class=\"project-card\">\n        <div class=\"project-thumbnail\">🍊</div>\n        <div class=\"project-body\">\n          <h3>만다린 게임 (Mandarin Puzzle)</h3>\n          <p>사과게임(Fruit Box)을 모티브로 제작한 17×10 반응형 드래그 퍼즐 웹게임입니다. 합이 10이 되는 상자를 만들어 귤을 터뜨리며, Web Audio API 기반 Pop 사운드 신디사이저, 120초 타이머, Supabase Cloud DB 연동 실시간 Top 5 명예의 전당 및 5중 보안 체계(IIFE 은닉, XSS 차단, 봇 방어)를 구현했습니다.</p>\n          <div class=\"skills-tags\" style=\"margin-top: 1rem;\">\n            <span class=\"skill-tag\">HTML5</span>\n            <span class=\"skill-tag\">CSS3</span>\n            <span class=\"skill-tag\">JavaScript</span>\n            <span class=\"skill-tag\">Web Audio API</span>\n            <span class=\"skill-tag\">Supabase</span>\n          </div>\n          <a href=\"game.html\" class=\"btn\" style=\"margin-top: 1.4rem;\">게임 플레이하기 &rarr;</a>\n        </div>\n      </div>\n\n      <!-- 프로젝트 4: KBO 야구 AI 브리핑 & 구장 기상 분석 시스템 -->\n      <div class=\"project-card\">\n        <div class=\"project-thumbnail\">⚾</div>\n        <div class=\"project-body\">\n          <h3>KBO 야구 AI 브리핑 &amp; 구장 기상 분석</h3>\n          <p>네이버 스포츠 뉴스 실시간 수집 및 OpenAI LLM 기반 심층 브리핑 보고서 자동 생성, 기상청 API 연동 전국 11개 구장 기상 관측 및 우천 취소 지수 분석 데스크톱 플랫폼입니다.</p>\n          <div class=\"skills-tags\" style=\"margin-top: 1rem;\">\n            <span class=\"skill-tag\">Python</span>\n            <span class=\"skill-tag\">pywebview</span>\n            <span class=\"skill-tag\">OpenAI API</span>\n            <span class=\"skill-tag\">Web Scraping</span>\n            <span class=\"skill-tag\">Pandas</span>\n          </div>\n          <a href=\"https://github.com/algethi97/baseball_AI-breifing_project\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn\" style=\"margin-top: 1.4rem;\">저장소로 이동</a>\n        </div>\n      </div>\n\n      <!-- 프로젝트 5: NaJakHome (FastAPI & ngrok 웹 서비스) -->\n      <div class=\"project-card\">\n        <div class=\"project-thumbnail\">🏠</div>\n        <div class=\"project-body\">\n          <h3>NaJakHome - 풀스택 반응형 웹 서비스</h3>\n          <p>FastAPI와 ngrok 기반의 풀스택 웹 플랫폼입니다. 비동기 실시간 방명록(SQLite &amp; 허니팟 스팸 차단), 개인정보 보호 사진 갤러리(EXIF GPS 위치 영구 삭제 &amp; 2048px 고품질 리사이징), Supabase 연동 만다린 퍼즐 게임(Web Audio Pop 사운드 &amp; 실시간 Top 5) 및 원클릭 런처 환경을 제공합니다.</p>\n          <div class=\"skills-tags\" style=\"margin-top: 1rem;\">\n            <span class=\"skill-tag\">Python</span>\n            <span class=\"skill-tag\">FastAPI</span>\n            <span class=\"skill-tag\">SQLite</span>\n            <span class=\"skill-tag\">Pillow</span>\n            <span class=\"skill-tag\">Supabase</span>\n            <span class=\"skill-tag\">ngrok</span>\n          </div>\n          <a href=\"https://github.com/algethi97/localhost_webpage_1\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn\" style=\"margin-top: 1.4rem;\">저장소로 이동</a>\n        </div>\n      </div>\n\n      <!-- 프로젝트 6: Streamlit 기반 오션 테마 OpenAI 챗봇 -->\n      <div class=\"project-card\">\n        <div class=\"project-thumbnail\">🌊</div>\n        <div class=\"project-body\">\n          <h3>Ocean AI Chat - 오션 테마 Streamlit 챗봇</h3>\n          <p>Streamlit과 OpenAI 최신 모델(GPT-5.6)을 연동한 감성 오션 테마 챗봇 플랫폼입니다. 해수면↔심해 어비스 원클릭 테마 전환, 20개 S자 곡선 상승 기포(Bubbles) 파티클 및 글래스모피즘 연출, API 키 세션 메모리 전용 격리 보안, SQLite 기반 멀티세션 FIFO 큐 관리를 지원합니다.</p>\n          <div class=\"skills-tags\" style=\"margin-top: 1rem;\">\n            <span class=\"skill-tag\">Python</span>\n            <span class=\"skill-tag\">Streamlit</span>\n            <span class=\"skill-tag\">OpenAI API</span>\n            <span class=\"skill-tag\">SQLite</span>\n            <span class=\"skill-tag\">Glassmorphism</span>\n          </div>\n          <a href=\"https://github.com/algethi97/streamlit-basic\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"btn\" style=\"margin-top: 1.4rem;\">저장소로 이동</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- 홈으로 돌아가기 버튼 -->\n    <div style=\"text-align: center; margin-top: 2.5rem;\">\n      <a href=\"index.html\" style=\"color: var(--accent-orange); font-weight: 600;\">&larr; 홈으로 돌아가기</a>\n    </div>\n  </main>\n\n  <footer class=\"site-footer\">\n    <p>&copy; 2026 algethi97. All rights reserved.</p>\n  </footer>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n"
}